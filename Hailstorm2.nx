'=================================
' HAILSTORM II: EYE OF THE TEMPEST
' SEQUEL TO HAILSTORM, IN THE STYLE
' OF JUDGEMENT SILVERSWORD
' 32 AREAS IN FIVE SECTORS
'
' MODES (LEFT/RIGHT ON THE TITLE):
' ARCADE; TRAINING (REACH SECTOR 2:
' SLOW BULLETS, NO LIVES LOST, PICK
' A SECTOR WITH UP/DOWN); SECTOR
' SELECT (CLEAR THE GAME); SPECIAL
' (CLEAR WITHOUT CONTINUING: THE
' BOSSES, THEN ONE MORE); MAELSTROM
' (THE TRUE ENDING: FAST BULLETS, NO
' HIDDEN 1UP, KILLS SHOOT BACK)
'
' A   = FORWARD SHOT (NARROW,STRONG)
' B   = SPREAD SHOT (WIDE, WEAK)
' A+B = SHIELD. IT ABSORBS BULLETS,
'   BUT EACH ONE DRAINS IT AND IT
'   SHRINKS AS IT WEAKENS. AT 0% IT
'   SHATTERS. FIRING RECHARGES IT.
'
' SCORING: KILLS RAISE THE
' MULTIPLIER (MORE FOR FAST KILLS).
' IT DECAYS QUICKLY, AND EVERY
' ENEMY THAT ESCAPES KNOCKS IT DOWN
'
' SPRITES: 0 HITBOX, 1 SHIP,
' 2 SHIELD, 3-6 BOSS, 7-20 SHOTS,
' 21-32 ENEMIES, 33-63 BULLETS
'
' DATA LIVES IN ROM, NOT IN CODE:
' #3 AREA SCRIPTS, #4 BOSS PATTERNS,
' #5-9 SECTOR CHARACTER BANKS,
' #10 BACKDROPS. BUILD.PY MAKES
' THEM; SEE IT FOR THE BYTE LAYOUTS
'=================================

GLOBAL PX,PY,SC,HI,LIVES,INV,DEAD,HP,HPMAX,PH,PHT,T,BV,FL
GLOBAL BXO,BYO,GX,GY,NB,NSS,AA
GLOBAL SY1,RA,RB,WL,LHB,GOD,TGR
GLOBAL SHG,SHBRK,SHON,SHSZ,MUL,MMAX,LKT
GLOBAL QL,KIL,TOT,ESC,ONEUP,AREA,PLY,PLON,QUIT,SY0,NEAR
GLOBAL AP,NWT,NTY,NXX,NN,NDT,NDX,AK,TH2,TH3,SECT
GLOBAL P1,P2,P3,RS$,NSP,SNG,MX,TA,TWT,TWB,LU,MSGT
GLOBAL NU,HREST,UOX,UOY,LE,NRK,HX,HY,HSX,HSY,WOB,WY0,WY1,HDR
GLOBAL BSP,BMAP,BDM,FLR,FZ,PXL,PXR,UB,SVK
GLOBAL MODE,UNL,MXS,SS,DEMO,CNT,BSPD,IL,IR,IU,ID,PANEL,TB
GLOBAL AUTHOR$
DIM GLOBAL SV(2)

DIM GLOBAL BX(63),BY(63),BDX(63),BDY(63),BA(63),BK(63),BT(63),BAG(63)
DIM GLOBAL TC(7),TZ(7),HS(7),TP(7),TN(7),SR2(7),EXC(2)
DIM GLOBAL SHX(20),SHY(20),SHVX(20),SHVY(20),SHD(20),SHA(20)
DIM GLOBAL QA(11),QX(11),QY(11),QU(11),QV(11),QH(11),QT(11),QG(11)
DIM GLOBAL QB(15),QK(15),QHP(15),QCH(15),UH(3),UX(3),UY(3),GW(7),TUX(3),TUY(3),SPX(2),SPY(2),SHC(2),SHS(2),SHO(2),SHRT(2)
DIM GLOBAL FK(71),FV(71),FXL(71),FPL(71),FC(16)
DIM GLOBAL GA(7),GB(7),PHA(4),PHN(4),PHI(4),ROT(39),MB(4),MN$(4),LT(2)

'BULLET TYPES: CHAR,SIZE,HALF,PAL,
'BULLETS PER SPRITE
'0 SMALL 1 BIG 2 QUAD 3 TRI 4 RING
'5 SPARK, 6 EXPLOSION (HARMLESS),
'7 DRAIN (COSTS THE SHIELD DOUBLE)
FOR I=0 TO 7
  READ TC(I),TZ(I),HS(I),TP(I),TN(I)
NEXT I
DATA 12,0,4,2,1,13,0,4,7,1,32,1,8,2,4
DATA 34,1,8,2,3,64,2,12,7,8,14,0,4,3,0
DATA 36,1,8,4,0,13,0,4,3,2
EXC(0)=36
EXC(1)=38
EXC(2)=40

'ENEMIES: BASE SCORE, FRAMES THAT
'STILL COUNT AS A FAST KILL, HEALTH
'0 DART 1 SIDE FIGHTER 2 ORB
'3 GUNSHIP 4 HEAVY CARRIER 5 MINE
'6 STATION TURRET 7 BIG ASTEROID
'8 SMALL ASTEROID 9 WRECK AMBUSHER
'10 LIGHTNING TURRET 11 DRAIN ORB
'12 ALIEN POD 13 SWARMER
'14 STORM SOVEREIGN'S SHIELD
FOR I=0 TO 14
  READ QB(I),QK(I),QHP(I)
NEXT I
DATA 100,50,2,150,40,2,300,90,6
DATA 800,150,14,2500,240,45
DATA 200,60,4,500,120,10
DATA 400,120,14,150,60,4,250,40,3
DATA 600,90,12,350,60,8,900,150,16
DATA 50,30,1,3000,300,100

'THE SPIRE'S FLOOR: STEERING WEIGHT
'AND DEPTH FOR EACH OF ITS 72 LINES,
'AND ITS TWO BAND COLOURS (A FRAME
'OF ITS OWN, AS START-UP IS BUSY)
WAIT VBL
FOR I=0 TO 71
  FK(I)=(I+8)/80
  FV(I)=INT(1400/(I+6))
NEXT I
FC(0)=17
FC(16)=18

'THUNDERHEAD: HEAT WOBBLE OFFSETS,
'TURRET MOUNTS ON THE HULL
FOR I=0 TO 7
  READ GW(I)
NEXT I
DATA 0,1,2,1,0,-1,-2,-1
FOR I=0 TO 3
  READ TUX(I),TUY(I)
NEXT I
DATA 32,20,58,34,102,34,128,20

'SPREAD SHOT: THREE PELLETS
FOR I=0 TO 2
  A=(I-1)*0.45
  SPX(I)=SIN(A)*4.5
  SPY(I)=-COS(A)*4.5
NEXT I

'SHIELD SIZES (SMALL, MID, BIG):
'CHAR, SPRITE SIZE, OFFSET, RADIUS
FOR I=0 TO 2
  READ SHC(I),SHS(I),SHO(I),SHRT(I)
NEXT I
DATA 42,1,0,8,67,2,-4,12,60,3,-8,16

'TITLE LOGO GRADIENT
FOR I=0 TO 7
  READ GA(I),GB(I)
NEXT I
DATA 32,48,48,52,52,56,56,60,60,62,56,60,52,56,48,52

'SET GODDBG=1 FOR AN INVINCIBLE TEST
'RUN, FIRSTAREA=4 TO START AT BOSS
GODDBG=0
FIRSTAREA=1
'RELEASE INFO: THE AUTHOR IS CREDITED
'AFTER THE ENDING
AUTHOR$="JAMES PARROTT"
'MODE NAMES AND THE UNLOCK BIT EACH
'NEEDS (PERSISTENT RAM $E005)
FOR I=0 TO 4
  READ MN$(I),MB(I)
NEXT I
DATA "ARCADE",0,"TRAINING",1,"SECTOR",2
DATA "SPECIAL",4,"MAELSTROM",8
'EACH SECTOR'S BOSS AREA (SECTOR K
'STARTS AT BOA(K-1)+1); 33 IS SPECIAL
'MODE'S EXTRA BOSS
DIM BOA(6)
FOR I=0 TO 6
  READ BOA(I)
NEXT I
DATA 0,7,14,20,26,32,33
SS=1
CALL HSINIT

GAMEPAD 1
PAUSE OFF
LSNG=-1
MSGT=0
VOLUME 2,5,3
VOLUME 3,10,3

CALL SETUPSTARS
CALL STEPSTARS
ON RASTER CALL RAS

'---------------------------------
TITLE:
STOP
CALL RESETPLAY
CALL LOADSECTOR(1)
CALL SETUPSTARS
PH=0
TB=(MODE=4)*-1
HI=PEEKL($E010+TB*35)
CALL HUD
BG 0
PAL 7
CALL CTEXT(2,"H A I L S T O R M")
PAL 4
CALL CTEXT(3,"I I")
PAL 6
CALL CTEXT(4,"EYE OF THE TEMPEST")
PANEL=0
CALL TPANEL(0)
IDLE=0
PALETTE 3,,17,38,56
SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
TGR=1
DO
  CALL STEPSTARS
  INC T
  TGR=T+1
  IF PANEL=0 THEN
    Y=45+SIN(T*0.04)*1.5
    SPRITE 3,56,Y,112
    SPRITE 4,80,Y,112
    SPRITE 5,56,Y+24,115
    SPRITE 6,80,Y+24,115
  END IF
  'LEFT/RIGHT: MODE. UP/DOWN: SECTOR
  OM=MODE
  IF LEFT TAP(0) THEN CALL NEXTMODE(-1)
  IF RIGHT TAP(0) THEN CALL NEXTMODE(1)
  IF UP TAP(0) THEN ADD SS,1,1 TO MXS
  IF DOWN TAP(0) THEN ADD SS,-1,1 TO MXS
  IF MODE<>OM THEN
    TB=(MODE=4)*-1
    HI=PEEKL($E010+TB*35)
    CALL HUD
    IF PANEL THEN CALL TPANEL(1)
  END IF
  IF T MOD 8=0 THEN
    BG 0
    BG FILL 0,14 TO 19,14 CHAR 0
    M$=MN$(MODE)
    IF MODE=1 OR MODE=2 THEN M$=M$+" "+STR$(SS)
    PAL 6
    CALL CTEXT(14,"< "+M$+" >")
  END IF
  BG 0
  PAL 4
  IF T MOD 60<40 THEN
    CALL CTEXT(15,"PRESS A")
  ELSE
    CALL CTEXT(15,"       ")
  END IF
  'CONTROLS AND HIGH SCORES TAKE TURNS
  IF T MOD 300=0 THEN
    PANEL=1-PANEL
    CALL TPANEL(PANEL)
  END IF
  'ATTRACT MODE AFTER 20 IDLE SECONDS
  IF BUTTON(0) OR UP(0) OR DOWN(0) OR LEFT(0) OR RIGHT(0) THEN IDLE=0 ELSE INC IDLE
  IF IDLE>1200 THEN
    DEMO=-1
    EXIT
  END IF
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP
TGR=0
IF DEMO=0 THEN PLAY 2,96,10 SOUND 4

'---------------------------------
GAME:
SC=0
LIVES=3
MUL=1
MMAX=1
ONEUP=0
TKIL=0
TTOT=0
CNT=0
CLR=0
TRU=0
TEND=0
GOD=GODDBG
AREA=FIRSTAREA
IF MODE=1 OR MODE=2 THEN AREA=BOA(SS-1)+1
SPI=1
IF MODE=3 THEN AREA=BOA(1)
BSPD=1
IF MODE=1 THEN BSPD=0.75
IF MODE=4 THEN BSPD=1.3
IF DEMO THEN
  'DEMO: THE START OF A SECTOR ON
  'AUTOPILOT, INVINCIBLE, UNRECORDED
  DMO=MODE
  MODE=0
  BSPD=1
  GOD=1
  DMA=DMA MOD 5+1
  AREA=BOA(DMA-1)+1
  DEMOT=0
END IF

STAGE:
CALL RESETPLAY
PH=1
PHT=0
KIL=0
TOT=0
ESC=0
SHG=100
SHBRK=0
PX=72
PY=100
INV=90
DEAD=0
BV=0
FL=0
LKT=0
WV=1
BDRAWN=0
BTM=0
WRN=0
NWT=0
SQN=0
WVT=0
SPRITE 1 PAL 1 SIZE 1
SPRITE 0 PAL 1 PRIO 1
SPRITE 2 PAL 7
FOR I=7 TO 20
  SPRITE I PAL 4 SIZE 0
NEXT I
'AREA RECORD FROM ROM #3: KIND (0 =
'WAVES, ELSE A BOSS ID), PALETTE,
'BACKDROP AND ITS MODE, SONG, SECTOR,
'NAME, SECTOR LINE, LENGTH, THEN THE
'SPAWN ROWS
AP=ROM(3)+PEEKW(ROM(3)+1+(AREA-1)*2)
CALL LOADSECTOR(PEEK(AP+7))
'PROGRESS: THE FURTHEST SECTOR
'REACHED; SECTOR 2 UNLOCKS TRAINING
IF DEMO=0 AND MODE<>1 THEN
  K=MIN(5,SECT)
  IF K>MXS THEN
    MXS=K
    POKE $E006,MXS
  END IF
  IF MXS>1 THEN UNL=UNL OR 1
  POKE $E005,UNL
END IF
'THE TRUE FINAL PHASE NEEDS AN ARCADE
'OR MAELSTROM RUN WITH NO CONTINUES
'AND 95% DESTROYED
IF AREA=BOA(5) THEN TRU=CNT=0 AND (MODE=0 OR MODE=4) AND TKIL*100>=TTOT*95
AK=PEEK(AP)
P1=PEEK(AP+1)
P2=PEEK(AP+2)
P3=PEEK(AP+3)
BDE=PEEK(AP+4)
BDM=PEEK(AP+5)
SNG=PEEK(AP+6)
AP=AP+8
'MODES 9 TO 11 ARE STORMS
STM=BDM>=9 AND BDM<=11
LFL=0
CALL RSTR
AN$=RS$
CALL RSTR
SL$=RS$
ALEN=PEEKW(AP)
AP=AP+2
'KEEP THE SONG GOING BETWEEN AREAS
'OF A SECTOR
IF MUSIC(3)=0 OR SNG<>LSNG THEN MUSIC SNG
LSNG=SNG
IF AK THEN
  CALL LOADBOSS(AK)
  BXO=56
  BYO=-48
  SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
  SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
  IF AK=2 THEN
    SPRITE 5 SIZE 1
    SPRITE 6 SIZE 1
  ELSE IF AK=3 THEN
    FOR K=3 TO 6
      SPRITE K SIZE 1 FLIP 0,0
    NEXT K
  ELSE IF AK=5 THEN
    'STORM SOVEREIGN: ONE QUARTER,
    'FLIPPED FOUR WAYS
    SPRITE 5 FLIP 0,1
    SPRITE 6 FLIP 1,1
  END IF
END IF
PALETTE 3,,P1,P2,P3
CALL HUD
'AREA CARD. BG0 ROW TR SHOWS 48 PX
'DOWN; OVER THE SINKING EARTH THE
'CARD SITS JUST ABOVE IT
TR=6
IF BDE THEN
  CALL DRAWBACK(BDE,BDM)
  IF BDM<4 THEN TR=6+PLY\8
  IF BDM=1 THEN TR=3+PLY\8
END IF
BG 0
PAL 3
IF AK=0 THEN
  CALL CTEXT(TR,"AREA "+STR$(AREA))
  PAL 6
  CALL CTEXT(TR+2,AN$)
  PAL 4
  IF SL$<>"" THEN CALL CTEXT(TR+4,SL$)
  MSGT=120
ELSE
  PAL 4
  CALL CTEXT(TR,"WARNING")
  PAL 6
  CALL CTEXT(TR+2,"HERE COMES")
  PAL 4
  CALL CTEXT(TR+3,"[ "+AN$+" ]")
  MSGT=150
  WRN=150
END IF

DO
  INC T
  CALL STEPSTARS

  '--- PAUSE MENU
  IF PAUSE AND DEMO=0 THEN
    CALL PAUSEMENU
    IF QUIT THEN EXIT
  END IF

  '--- INPUT: A FORWARD, B SPREAD,
  '--- BOTH = SHIELD
  IF DEMO THEN
    'AUTOPILOT: WEAVE UNDER THE BOSS OR
    'ACROSS THE SCREEN, FIRING
    INC DEMOT
    TX=72+SIN(T*0.02)*44
    IF AK THEN TX=GX-8+SIN(T*0.03)*16
    IL=PX>TX+2
    IR=PX<TX-2
    IU=PY>104
    ID=PY<96
    IB=(T\120) MOD 3=0
    IA=NOT IB
    IF BUTTON(0,0) OR BUTTON(0,1) OR DEMOT>1500 THEN EXIT
  ELSE
    IA=BUTTON(0,0)
    IB=BUTTON(0,1)
  END IF
  SHON=0
  IF IA AND IB AND DEAD=0 AND SHBRK=0 AND SHG>0 THEN SHON=-1

  IF DEAD=0 THEN
    IF SHON THEN CALL SHIPMOVE(1.2) ELSE CALL SHIPMOVE(1.7)
    IF SHON=0 THEN
      IF IA THEN
        IF T MOD 5=0 THEN
          CALL SHOT(PX+4,PY-6,0,-5,3,10)
          PLAY 2,72,2 SOUND 3
        END IF
      ELSE IF IB THEN
        IF T MOD 7=0 THEN
          FOR K=0 TO 2
            CALL SHOT(PX+4,PY-2,SPX(K),SPY(K),1,11)
          NEXT K
          PLAY 2,62,2 SOUND 3
        END IF
      END IF
      'FIRING RECHARGES THE SHIELD
      IF IA OR IB THEN
        SHG=MIN(100,SHG+0.12)
        IF SHBRK AND SHG>=30 THEN
          SHBRK=0
          PLAY 3,80,10 SOUND 4
        END IF
      END IF
    END IF
  END IF

  '--- SHIELD SPRITE: SHRINKS AS IT
  '--- WEAKENS, SHIMMERS BY FLIPPING
  IF SHON THEN
    SZ=0
    IF SHG>33 THEN SZ=1
    IF SHG>66 THEN SZ=2
    IF SZ<>SHSZ THEN CALL SETSHIELD(SZ)
    SPRITE 2,PX+SHO(SZ),PY+SHO(SZ),SHC(SZ)
    SPRITE 2 FLIP (T\4) MOD 2,(T\8) MOD 2
  ELSE
    SPRITE OFF 2
  END IF

  '--- PLAYER SHOTS
  CALL MOVESHOTS(-1)

  '--- PARALLAX: BG0 STREAKS OR SURFACE
  IF NEAR AND MSGT=0 THEN
    SY0=(SY0-NSP) AND 255
    SCROLL 0,0,SY0
    HSY=SY0
  END IF

  '--- THE SPIRE'S FLOOR: EACH LINE'S
  '--- SCROLL AND COLOUR FOR THE
  '--- RASTER SUB
  IF FLR THEN
    ADD FZ,3
    CX=(PX-72)*0.7
    FOR J=0 TO 71
      FXL(J)=48+CX*FK(J)
      FPL(J)=FC((FV(J)+FZ) AND 16)
    NEXT J
  END IF

  '--- LIGHTNING IN THE STORM SECTOR
  IF STM AND WRN=0 THEN
    IF LFL>0 THEN
      DEC LFL
      PALETTE 0,(LFL MOD 2)*21+2,,,
      IF LFL=0 THEN PALETTE 0,1,,,
    ELSE IF RND<0.005 THEN
      LFL=5
      PLAY 3,4,20 SOUND 7
    END IF
  END IF

  '--- ENEMY BULLETS PULSE SO THEY STAND
  '--- OUT FROM THE BACKGROUND
  IF T MOD 4=0 THEN
    IF T MOD 8=0 THEN
      PALETTE 2,,49,,
      PALETTE 7,,11,,
    ELSE
      PALETTE 2,,54,,
      PALETTE 7,,31,,
    END IF
  END IF

  '--- ENEMY BULLETS (AND THE SHIELD)
  CALL MOVEB

  '--- AREA SCRIPT: A SPAWNER WORKS
  '--- THROUGH THE AREA'S DATA
  IF WV=2 THEN
    INC WVT
    IF SQN>0 THEN
      DEC SQC
      IF SQC<=0 THEN
        CALL SPAWN(SQT,SQX,SQI)
        ADD SQX,SQDX
        INC SQI
        DEC SQN
        SQC=SQD
      END IF
    ELSE IF NWT>=0 AND WVT>=NWT THEN
      SQT=NTY
      SQX=NXX
      SQN=NN
      SQD=NDT
      SQDX=NDX
      SQC=0
      SQI=0
      CALL NEXTROW
    END IF
  END IF
  IF WV=2 OR AK>0 THEN CALL MOVEE
  IF WV=2 AND NWT<0 AND SQN=0 AND QL=0 THEN EXIT

  '--- PLANETS: THE EARTH SINKS AWAY,
  '--- THE MOON RISES AND STOPS
  IF PLON=1 AND T MOD 10=0 THEN
    DEC PLY
    SCROLL 0,0,PLY
    IF PLY<16 THEN
      PLON=0
      CALL NEARON
    END IF
  ELSE IF PLON=2 AND MSGT=0 AND T MOD 5=0 THEN
    INC PLY
    SCROLL 0,0,PLY
    IF PLY>=96 THEN PLON=3
  END IF

  '--- BOSS
  IF AK>0 THEN
    IF BDRAWN AND HP>0 THEN CALL BOSSMOVE
    IF BV OR PHT>0 THEN INC BTM
    IF BV AND DEAD=0 THEN CALL BOSSFIRE
    IF PH=1 AND HP<=TH2 THEN
      CALL PHASEUP(2)
    ELSE IF PH=2 AND HP<=TH3 THEN
      CALL PHASEUP(3)
    END IF
    IF PHT>0 THEN
      DEC PHT
      IF PHT=0 THEN BV=-1
    END IF
    'A QUALIFYING RUN: THE EYE OPENS
    IF HP<=0 AND AK=5 AND TRU AND PH=3 THEN
      CALL PHASEUP(4)
      HP=400
      HPMAX=HP
      P1=32
      P2=52
      P3=63
      MUSIC 28
      TEND=-1
    END IF
    IF HP<=0 THEN EXIT
  END IF
  IF FL=2 THEN PALETTE 3,,52,62,63
  IF FL=1 THEN PALETTE 3,,P1,P2,P3
  IF FL>0 THEN DEC FL

  '--- SIREN BEFORE THE BOSS
  IF WRN>0 THEN
    DEC WRN
    IF WRN MOD 30=29 THEN PLAY 3,62,14 SOUND 4
    IF WRN MOD 30<15 AND WRN>0 THEN
      PALETTE 0,16,,,
    ELSE
      PALETTE 0,1,,,
    END IF
  END IF

  '--- PLAYER SPRITES AND COLLISION
  IF DEAD=0 THEN
    CALL DRAWSHIP
    IF INV=0 AND GOD=0 THEN
      'SPARKS AND EXPLOSIONS SHARE THE
      'SLOTS, SO SKIP HARMLESS HITS
      HITP=0
      H0=21
      WHILE H0<=63
        IF SPRITE HIT(0,H0 TO 63) THEN
          K=BK(HIT)
          IF K=0 OR K=4 THEN
            HITP=-1
            H0=64
          ELSE
            H0=HIT+1
          END IF
        ELSE
          H0=64
        END IF
      WEND
      IF HITP THEN CALL PLAYERDIE
    END IF
    IF INV>0 THEN DEC INV
  ELSE
    DEC DEAD
    IF DEAD=0 THEN
      IF LIVES<0 THEN
        CALL CONTPROMPT
        IF LIVES<0 THEN EXIT
      END IF
      PX=72
      PY=100
      SHG=100
      SHBRK=0
    END IF
  END IF

  '--- MULTIPLIER DECAYS QUICKLY
  INC LKT
  IF LKT>60 AND MUL>1 THEN MUL=MAX(1,MUL-0.015)

  '--- CARD TEXT, THEN WAVES OR BOSS
  IF MSGT>0 THEN
    DEC MSGT
    IF MSGT=0 THEN
      BG 0
      BG FILL 0,TR TO 19,TR+4 CHAR 0
      IF BMAP THEN
        CALL MAPCOPY
        NEAR=-1
        'THE EYEWALL'S CLOUDS SWIRL
        IF BDM=11 THEN
          WOB=-1
          WY0=12
          WY1=999
          HSX=0
        END IF
        'HIVE CANYON: A NARROW CORRIDOR
        IF BDM=13 THEN
          PXL=22
          PXR=122
        END IF
      ELSE IF BDM=12 THEN
        CALL DRAWFLOOR
      ELSE IF PLON=0 AND BDM<>8 THEN
        CALL NEARON
      END IF
      IF AK=0 THEN
        WV=2
        WVT=0
        SQN=0
        CALL NEXTROW
      ELSE
        BDRAWN=-1
      END IF
    END IF
  END IF

  '--- HUD
  IF T MOD 4=0 THEN
    BG 1
    PAL 6
    NUMBER 0,0,SC,6
    NUMBER 8,0,INT(MUL),1
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    IF SHBRK THEN PAL 3 ELSE PAL 7
    NUMBER 12,0,INT(SHG),3
    IF AK=0 THEN
      HB=0
      IF WV=2 THEN HB=INT(MIN(1,WVT/ALEN)*20)
    ELSE
      HB=INT(HP*20/HPMAX+0.99)
    END IF
    IF HB<>LHB THEN
      LHB=HB
      PAL 6
      IF HB>0 THEN BG FILL 0,1 TO HB-1,1 CHAR 27
      IF HB<20 THEN BG FILL HB,1 TO 19,1 CHAR 28
    END IF
  END IF

  WAIT VBL
LOOP

'---------------------------------
IF DEMO THEN
  DEMO=0
  MODE=DMO
  SC=0
  QUIT=-1
END IF
IF QUIT THEN
  'LET GO OF THE A PRESS THAT CHOSE QUIT
  QUIT=0
  WAIT 10
  GOTO TITLE
END IF
SHON=0
SPRITE OFF 2
ADD TKIL,KIL
ADD TTOT,TOT
IF LIVES<0 THEN
  RES$="GAME OVER"
  GOTO RESULTS
END IF

IF AK=0 THEN
  'AREA CLEAR: THE TALLY. LEFTOVER
  'BULLETS BURST INTO SPARKS, SHOTS
  'FLY ON, AND THE SHIP CAN STILL MOVE
  CALL CANCEL
  NEAR=0
  FLR=0
  BG 0
  CLS 0
  SCROLL 0,0,0
  PLON=0
  DP=100
  IF TOT>0 THEN DP=INT(KIL*100/TOT)
  'AREA BONUSES GROW BY SECTOR
  BONUS=DP*SECT*50
  PERF=(ESC=0) AND (TOT>0)
  IF PERF THEN
    ADD BONUS,5000*SECT
    MUL=MIN(9.9,MUL+1)
  END IF
  ADD SC,BONUS
  PAL 3
  CALL CTEXT(3,"AREA "+STR$(AREA)+" CLEAR")
  PAL 6
  TEXT 4,6,"DESTROY"
  NUMBER 12,6,DP,3
  TEXT 15,6,"%"
  TEXT 4,7,"ESCAPED"
  NUMBER 13,7,ESC,2
  TEXT 4,9,"BONUS"
  NUMBER 10,9,BONUS,6
  IF PERF THEN
    PAL 4
    CALL CTEXT(11,"PERFECT!")
    PLAY 2,90,20 SOUND 4
  END IF
  CALL HUD
  FOR N=0 TO 149
    INC T
    CALL STEPSTARS
    CALL SHIPMOVE(1.7)
    CALL MOVESHOTS(0)
    CALL MOVEB
    CALL DRAWSHIP
    WAIT VBL
  NEXT N
  INC AREA
  GOTO STAGE
END IF

'BOSS DOWN (A TWIN BOSS BLOWS UP
'WHERE ITS LAST UNIT FELL)
BV=0
INV=0
IF AK=2 THEN
  BXO=UX(LU)-12
  BYO=UY(LU)-8
ELSE IF AK>=3 THEN
  BXO=GX-24
  BYO=GY-24
END IF
CALL CANCEL
STOP
BTB=MAX(0,90-BTM\60)*1000
FOR N=0 TO 119
  CALL STEPSTARS
  IF N MOD 4=0 THEN
    CALL FIRE(BXO+RND(48),BYO+RND(48),RND*2*PI,0.2,6)
    PLAY 3,10+RND(20),12 SOUND 5
  END IF
  IF N=96 THEN
    'FINAL BLAST: A RING OF FIREBALLS
    FOR J=0 TO 7
      CALL FIRE(BXO+24,BYO+24,J*PI/4,0.9,6)
    NEXT J
    PLAY 3,6,40 SOUND 7
  END IF
  IF N MOD 8<4 THEN
    PALETTE 3,,63,63,63
  ELSE
    PALETTE 3,,P1,P2,P3
  END IF
  CALL MOVEB
  IF NEAR THEN
    SY0=(SY0-NSP) AND 255
    SCROLL 0,0,SY0
  END IF
  INC T
  CALL SHIPMOVE(1.7)
  CALL MOVESHOTS(0)
  CALL DRAWSHIP
  IF N=100 THEN
    SPRITE OFF 3 TO 6
    IF AK=3 THEN
      WOB=0
      BG 0
      CLS 0
    END IF
    'VICTORY FANFARE
    TRACK 8,0
    TRACK 9,1
  END IF
  WAIT VBL
NEXT N
CALL CLEARB
ADD SC,BTB+TWB
NEAR=0
FLR=0
BG 0
CLS 0
SCROLL 0,0,0
PAL 3
CALL CTEXT(4,AN$+" DOWN")
PAL 6
TEXT 3,7,"TIME BONUS"
NUMBER 14,7,BTB,5
IF TWB THEN
  TEXT 3,9,"TWIN BONUS"
  NUMBER 14,9,TWB,5
END IF
CALL HUD
WAIT 150
IF MODE=1 THEN
  RES$="TRAINING OVER"
  GOTO RESULTS
END IF
'SPECIAL: BOSS AFTER BOSS, THEN THE
'TEMPEST (AREA 33)
IF MODE=3 AND AREA<BOA(6) THEN
  INC SPI
  AREA=BOA(SPI)
  GOTO STAGE
END IF
IF AREA<BOA(5) THEN
  INC AREA
  GOTO STAGE
END IF
CLR=-1
IF MODE=3 THEN
  RES$="SPECIAL CLEAR"
ELSE
  CALL ENDING(1-(TKIL*100>=TTOT*90)-TEND)
  RES$="ALL AREAS CLEAR"
END IF

'---------------------------------
RESULTS:
STOP
WAIT 30
CALL RESETPLAY
'RANK IN THIS MODE'S TOP 5 (TRAINING
'ISN'T RECORDED; MAELSTROM HAS ITS
'OWN TABLE)
TB=(MODE=4)*-1
RK=5
IF MODE<>1 THEN
  FOR R=4 TO 0 STEP -1
    IF SC>PEEKL($E010+TB*35+R*7) THEN RK=R
  NEXT R
END IF
'UNLOCKS: 1 TRAINING, 2 SECTOR
'SELECT, 4 SPECIAL, 8 MAELSTROM
NL=UNL
IF CLR AND MODE<>3 THEN
  NL=NL OR 2
  IF CNT=0 AND MODE<>2 THEN NL=NL OR 4
  IF TEND THEN NL=NL OR 8
END IF
GAIN=NL AND NOT UNL
UNL=NL
POKE $E005,UNL
PH=0
HI=PEEKL($E010+TB*35)
IF RK=0 THEN HI=SC
CALL HUD
BG 0
PAL 3
CALL CTEXT(3,RES$)
PAL 6
CALL CTEXT(5,"SCORE")
NUMBER 7,6,SC,6
DP=100
IF TTOT>0 THEN DP=INT(TKIL*100/TTOT)
TEXT 3,8,"DESTROY"
NUMBER 12,8,DP,3
TEXT 15,8,"%"
TEXT 3,9,"BEST CHAIN X"
NUMBER 15,9,INT(MMAX),1
TEXT 16,9,"."
NUMBER 17,9,INT(MMAX*10) MOD 10,1
IF CNT THEN
  TEXT 3,10,"CONTINUES"
  NUMBER 15,10,CNT,2
END IF
PAL 4
IF RK=0 THEN
  CALL CTEXT(13,"NEW HIGH SCORE!")
ELSE IF RK<5 THEN
  CALL CTEXT(13,"TOP 5 SCORE!")
END IF
CALL WAITA

IF RK<5 THEN
  'NAME ENTRY: UP/DOWN PICKS A LETTER,
  'A CONFIRMS, B GOES BACK
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"ENTER YOUR NAME")
  PAL 6
  CALL CTEXT(12,"UP DOWN  LETTER")
  CALL CTEXT(13,"A NEXT  B BACK")
  FOR K=0 TO 2
    LT(K)=65
  NEXT K
  NPOS=0
  DO
    CALL STEPSTARS
    INC T
    IF UP TAP(0) THEN ADD LT(NPOS),1,65 TO 90
    IF DOWN TAP(0) THEN ADD LT(NPOS),-1,65 TO 90
    IF BUTTON TAP(0,1) AND NPOS>0 THEN DEC NPOS
    IF BUTTON TAP(0,0) THEN
      INC NPOS
      PLAY 2,80+NPOS*4,6 SOUND 4
      IF NPOS>2 THEN EXIT
    END IF
    FOR K=0 TO 2
      IF K=NPOS AND T MOD 20<10 THEN PAL 4 ELSE PAL 6
      TEXT 7+K*2,8,CHR$(LT(K))
    NEXT K
    WAIT VBL
  LOOP
  'SHIFT LOWER ENTRIES DOWN, WRITE OURS
  A=$E010+TB*35+RK*7
  IF RK<4 THEN COPY A,(4-RK)*7 TO A+7
  POKEL A,SC
  FOR K=0 TO 2
    POKE A+4+K,LT(K)
  NEXT K
END IF

IF GAIN THEN
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"UNLOCKED!")
  PAL 6
  FOR K=1 TO 4
    M$=MN$(K)
    IF K=2 THEN M$="SECTOR SELECT"
    IF GAIN AND MB(K) THEN CALL CTEXT(5+K*2,M$)
  NEXT K
  PLAY 2,90,30 SOUND 4
  CALL WAITA
END IF
GOTO TITLE

'=================================
'RUNS BEFORE EVERY SCREEN LINE
SUB RAS
  R=RASTER
  IF R=0 THEN
    'HUD LINES: BG1 ONLY, NO SPRITES OR
    'BG0 (BIT 0 SPRITES, 1 BG0, 2 BG1)
    SCROLL 1,0,0
    POKE $FF20,%100
  ELSE IF R=12 THEN
    SCROLL 1,0,RA
    POKE $FF20,%111
  ELSE IF R=WL THEN
    SCROLL 1,0,RB
  END IF
  IF FLR THEN
    IF R>=56 THEN
      J=R-56
      SCROLL 0,FXL(J),0
      PALETTE 5,,FPL(J),,
    END IF
  ELSE IF WOB THEN
    IF R>=WY0 AND R<WY1 THEN
      SCROLL 0,(HSX+GW((R+T\2) AND 7)) AND 255,HSY
    ELSE IF R=WY1 THEN
      SCROLL 0,HSX,HSY
    END IF
  END IF
  IF TGR THEN
    IF R>=16 AND R<24 THEN
      K=(R+TGR\2) AND 7
      PALETTE 7,,GA(K),GB(K),63
    END IF
  END IF
END SUB

'STARS: BG1 ROWS 2-31 FORM A 240 PX
'RING. THE RASTER SUB SKIPS THE HUD
'ROWS SO THEY NEVER SCROLL INTO VIEW
SUB STEPSTARS
  SY1=SY1-2
  IF SY1<0 THEN ADD SY1,240
  IF SY1<228 THEN
    RA=SY1+16
  ELSE
    RA=(SY1+32) AND 255
  END IF
  RB=(SY1+32) AND 255
  WL=240-SY1
  IF WL<=12 THEN WL=-1
END SUB

SUB SETUPSTARS
  BG 1
  CLS 1
  PAL 0
  FOR I=0 TO 70
    CELL RND(19),2+RND(29),29+RND(2)
  NEXT I
END SUB

SUB HUD
  BG 1
  BG FILL 0,0 TO 19,1 CHAR 0
  PAL 6
  NUMBER 0,0,SC,6
  IF PH=0 THEN
    TEXT 11,0,"HI"
    NUMBER 14,0,HI,6
  ELSE
    TEXT 7,0,"X"
    NUMBER 8,0,INT(MUL),1
    TEXT 9,0,"."
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    PAL 7
    NUMBER 12,0,INT(SHG),3
    TEXT 15,0,"%"
    PAL 1
    FOR K=0 TO 2
      IF K<LIVES THEN CELL 17+K,0,26 ELSE CELL 17+K,0,0
    NEXT K
  END IF
  LHB=-1
END SUB

SUB CTEXT(ROW,M$)
  TEXT (20-LEN(M$))\2,ROW,M$
END SUB

SUB RESETPLAY
  CALL CLEARB
  FOR I=0 TO 11
    QA(I)=0
  NEXT I
  FOR I=7 TO 20
    SHA(I)=0
  NEXT I
  QL=0
  SPRITE OFF
  PLON=0
  NEAR=0
  BG 0
  CLS 0
  SCROLL 0,0,0
  PALETTE 0,1,,,
  PALETTE 7,,11,47,63
  NB=33
  NSS=7
  NSP=4
  WOB=0
  NRK=0
  BMAP=0
  FLR=0
  PXL=0
  PXR=144
  T=0
  SHSZ=-1
END SUB

SUB CLEARB
  FOR I=33 TO 63
    BA(I)=0
    BK(I)=0
  NEXT I
  SPRITE OFF 33 TO 63
END SUB

'BACKDROP E IN BG0. MODE M: 1 A
'PLANET SINKING AWAY, 2 RISING FROM
'BELOW, 3 STILL; THEIR 20X12 MAPS GO
'IN ROWS 18-29. 4 TO 7: A MAP THAT
'LOOPS AS IT SCROLLS, AT M-3 PX A
'FRAME. 8: ONLY LOADED (A BOSS DRAWS
'IT). 10 AND 11: STORM CLOUDS AT 2
'AND 1 PX. (9, RAIN, HAS NO MAP).
'12: THE FLOOR, DRAWN AFTER THE CARD.
'13: CANYON WALLS AT 2 PX
SUB DRAWBACK(E,M)
  CALL LOADBACK(E)
  BG 0
  IF M=8 OR M=12 THEN EXIT SUB
  IF M<4 THEN
    BG COPY 0,0,20,12 TO 0,18
    PLON=M
    PLY=80
    IF M=2 THEN PLY=16
    IF M=3 THEN PLY=64
    SCROLL 0,0,PLY
  ELSE
    CALL MAPCOPY
    BMAP=-1
    NSP=M-3
    IF M>9 THEN NSP=M-8
    IF M=13 THEN NSP=2
    SY0=0
    SCROLL 0,0,0
  END IF
END SUB

'THE SPIRE'S PERSPECTIVE FLOOR (32X9)
'IN BG0 ROWS 7-15: SCREEN LINES 56-127
SUB DRAWFLOOR
  BG 0
  BG COPY 0,0,32,9 TO 0,7
  FZ=0
  FLR=-1
END SUB

'A LOOPING MAP FILLS BG0'S 32 ROWS;
'A 16-ROW MAP IS DRAWN TWICE
SUB MAPCOPY
  BG 0
  H=PEEK(BSP+3)
  BG COPY 0,0,20,H TO 0,0
  IF H=16 THEN BG COPY 0,0,20,16 TO 0,16
END SUB

'NEAR PARALLAX LAYER: SPEED STREAKS
'SCATTERED OVER BG0, WHICH SCROLLS
'TWICE AS FAST AS THE FAR STARS. IT IS
'OFF WHILE BG0 SHOWS TEXT OR THE EARTH
SUB NEARON
  BG 0
  CLS 0
  PAL 0
  N=22
  'DOWNPOUR: DENSER AND FASTER RAIN
  IF BDM=9 THEN
    N=70
    NSP=6
  END IF
  FOR I=0 TO N
    CELL RND(19),RND(31),15+RND(2)
  NEXT I
  NEAR=-1
END SUB

SUB SHIPMOVE(SP)
  IF DEMO=0 THEN
    IL=LEFT(0)
    IR=RIGHT(0)
    IU=UP(0)
    ID=DOWN(0)
  END IF
  IF IL THEN ADD PX,-SP
  IF IR THEN ADD PX,SP
  IF IU THEN ADD PY,-SP
  IF ID THEN ADD PY,SP
  PX=MAX(PXL,MIN(PXR,PX))
  PY=MAX(12,MIN(112,PY))
END SUB

'SHIP FRAME: UPRIGHT OR BANKED (LEFT =
'RIGHT BANK, MIRRORED), FLAME FLICKERS
SUB DRAWSHIP
  FR=(T\3) MOD 2
  IF IL THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 1,0
  ELSE IF IR THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 0,0
  ELSE
    SCH=2+FR*2
    SPRITE 1 FLIP 0,0
  END IF
  IF INV>0 AND INV MOD 6<3 THEN
    SPRITE 1,PX,-32,SCH
    SPRITE 0,PX+4,-32,1
  ELSE
    SPRITE 1,PX,PY,SCH
    SPRITE 0,PX+4,PY+4,1
  END IF
END SUB

'MOVE PLAYER SHOTS; CO=0 SKIPS HITS
SUB MOVESHOTS(CO)
  FOR I=7 TO 20
    IF SHA(I) THEN
      ADD SHX(I),SHVX(I)
      ADD SHY(I),SHVY(I)
      IF SHY(I)<4 OR SHX(I)<-8 OR SHX(I)>160 THEN
        SHA(I)=0
        SPRITE OFF I
      ELSE
        SPRITE I,SHX(I),SHY(I),
        IF CO AND QL>0 THEN
          IF SPRITE HIT(I,21 TO 32) THEN
            E=HIT-21
            IF QA(E) THEN
              SHA(I)=0
              SPRITE OFF I
              CALL HURTE(E,SHD(I))
            END IF
          END IF
        END IF
        IF CO AND SHA(I) AND BV THEN
          IF SPRITE HIT(I,3 TO 6) THEN
            SHA(I)=0
            SPRITE OFF I
            CALL BOSSHIT(SHD(I),HIT)
          END IF
        END IF
      END IF
    END IF
  NEXT I
END SUB

'PLAYER SHOT IN THE NEXT SLOT 7-20
SUB SHOT(X0,Y0,VX,VY,D,C)
  I=NSS
  ADD NSS,1,7 TO 20
  SHA(I)=-1
  SHX(I)=X0
  SHY(I)=Y0
  SHVX(I)=VX
  SHVY(I)=VY
  SHD(I)=D
  SPRITE I,X0,Y0,C
END SUB

SUB SETSHIELD(SZ)
  SHSZ=SZ
  SPRITE 2 SIZE SHS(SZ)
  'ABSORB DISTANCE PER BULLET TYPE
  FOR K=0 TO 7
    R=SHRT(SZ)+HS(K)*0.5
    SR2(K)=R*R
  NEXT K
END SUB

'BK: 0 BULLET, 2 SPARK, 3 EXPLOSION
SUB MOVEB
  CX=PX+8
  CY=PY+8
  FOR I=33 TO 63
    IF BA(I) THEN
      IF BK(I)=3 THEN
        INC BAG(I)
        IF BAG(I)>=15 THEN
          BA(I)=0
          BK(I)=0
          SPRITE OFF I
        ELSE
          ADD BX(I),BDX(I)
          ADD BY(I),BDY(I)
          SPRITE I,BX(I),BY(I),EXC(BAG(I)\5)
        END IF
      ELSE
        ADD BX(I),BDX(I)
        ADD BY(I),BDY(I)
        IF BY(I)>130 OR BY(I)<-24 OR BX(I)<-24 OR BX(I)>162 THEN
          BA(I)=0
          SPRITE OFF I
        ELSE IF SHON AND BK(I)=0 THEN
          TY=BT(I)
          DX=BX(I)+HS(TY)-CX
          DY=BY(I)+HS(TY)-CY
          IF DX*DX+DY*DY<SR2(TY) THEN
            BA(I)=0
            SPRITE OFF I
            CALL ABSORB(TN(TY))
          ELSE
            SPRITE I,BX(I),BY(I),
          END IF
        ELSE
          SPRITE I,BX(I),BY(I),
          'ASTEROIDS STOP ENEMY BULLETS
          IF NRK AND BK(I)=0 THEN
            IF SPRITE HIT(I,21 TO 32) THEN
              K=QT(HIT-21)
              IF K=7 OR K=8 THEN
                BA(I)=0
                SPRITE OFF I
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF
  NEXT I
END SUB

'THE SHIELD SOAKED UP N BULLETS
SUB ABSORB(N)
  SHG=SHG-4*N
  IF SHG<=0 THEN
    SHG=0
    SHBRK=-1
    SHON=0
    SPRITE OFF 2
    PLAY 3,20,30 SOUND 9
    CALL FIRE(PX+8,PY+8,0,0,6)
  ELSE
    PLAY 2,84,1 SOUND 8
  END IF
END SUB

'PHASE CHANGES TURN BULLETS INTO
'HARMLESS SPARKS
SUB CANCEL
  FOR I=33 TO 63
    IF BA(I) THEN
      IF BK(I)=0 THEN
        BK(I)=2
        ADD BX(I),HS(BT(I))-4
        ADD BY(I),HS(BT(I))-4
        BT(I)=5
        BDX(I)=BDX(I)*0.4
        BDY(I)=BDY(I)*0.4-0.5
        SPRITE I,BX(I),BY(I),14
        SPRITE I PAL 4 SIZE 0
      END IF
    END IF
  NEXT I
END SUB

SUB FIRE(X0,Y0,AN,SPD,TY)
  I=NB
  ADD NB,1,33 TO 63
  IF BA(I) THEN EXIT SUB
  BA(I)=-1
  BK(I)=0
  IF TY=5 THEN BK(I)=2
  IF TY=6 THEN
    BK(I)=3
    BAG(I)=0
  END IF
  BT(I)=TY
  BX(I)=X0-HS(TY)
  BY(I)=Y0-HS(TY)
  'TRAINING SLOWS BULLETS, MAELSTROM
  'SPEEDS THEM UP
  BDX(I)=COS(AN)*SPD*BSPD
  BDY(I)=SIN(AN)*SPD*BSPD
  SPRITE I,BX(I),BY(I),TC(TY)
  SPRITE I PAL TP(TY) SIZE TZ(TY)
END SUB

SUB AIM(X0,Y0)
  DX=PX+8-X0
  DY=PY+8-Y0
  IF DX=0 THEN DX=0.001
  AA=ATAN(DY/DX)
  IF DX<0 THEN AA=AA+PI
END SUB

'NEW ENEMY IN THE FIRST FREE SLOT
SUB SPAWN(TY,X0,IX)
  LE=-1
  FOR E=0 TO 11
    IF QA(E)=0 THEN
      LE=E
      QA(E)=-1
      QT(E)=TY
      QG(E)=0
      QX(E)=X0
      QY(E)=-16
      QH(E)=QHP(TY)
      S=21+E
      BK(S)=4
      INC TOT
      SPRITE S PAL 3 SIZE 1 FLIP 0,0
      IF TY=0 THEN
        'DART: A PINK FIGHTER, DIVING
        QU(E)=X0
        SPRITE S PAL 2 FLIP 0,1
      ELSE IF TY=1 THEN
        'SIDE FIGHTER: FAST, FROM A SIDE
        IF X0>0 THEN
          QX(E)=-16
          QY(E)=X0
          QU(E)=2.2
        ELSE
          QX(E)=160
          QY(E)=-X0
          QU(E)=-2.2
          SPRITE S FLIP 1,0
        END IF
      ELSE IF TY=2 THEN
        'ORB: CROSSES, FIRING RINGS
        QV(E)=24+IX*14
        QY(E)=QV(E)
        IF X0<80 THEN QU(E)=0.8 ELSE QU(E)=-0.8
        SPRITE S PAL 7
      ELSE IF TY=4 OR TY=7 THEN
        'HEAVY CARRIER, BIG ASTEROID
        QY(E)=-24
        QU(E)=(68-X0)/300
        SPRITE S SIZE 2
      ELSE IF TY=8 THEN
        QU(E)=(72-X0)/200
      ELSE IF TY=9 THEN
        'AMBUSHER: RISES FROM BELOW
        QY(E)=130
      ELSE IF TY=11 THEN
        QU(E)=X0
      ELSE IF TY=13 THEN
        QU(E)=0
        QV(E)=1
        SPRITE S SIZE 0
      END IF
      'THE REST DROP IN FROM THE TOP
      SPRITE S,QX(E),QY(E),QCH(TY)
      EXIT SUB
    END IF
  NEXT E
END SUB

SUB MOVEE
  QL=0
  NRK=0
  FOR E=0 TO 11
    IF QA(E) THEN
      INC QG(E)
      G=QG(E)
      TY=QT(E)
      X0=QX(E)+8
      Y0=QY(E)+8
      IF TY=0 THEN
        ADD QY(E),1.3
        QX(E)=QU(E)+SIN(G*0.05)*28
        IF G=40 OR (G=75 AND AREA>1) THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0+4,AA,1.1,0)
        END IF
      ELSE IF TY=1 THEN
        ADD QX(E),QU(E)
        ADD QY(E),G*0.012
        IF G=30 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0,AA,1.2,0)
        END IF
      ELSE IF TY=2 THEN
        ADD QX(E),QU(E)
        QY(E)=QV(E)+SIN(G*0.06)*8
        IF G MOD 80=40 THEN
          N4=4+(AREA>2)*-2
          FOR K=1 TO N4
            CALL FIRE(X0,Y0,K*2*PI/N4+G,0.8,1)
          NEXT K
        END IF
      ELSE IF TY=3 THEN
        IF G<70 THEN
          ADD QY(E),0.7
        ELSE IF G>260 THEN
          ADD QY(E),-0.8
        END IF
        IF G=100 OR G=160 OR G=220 THEN
          CALL AIM(X0,Y0)
          FOR K=-1 TO 1
            CALL FIRE(X0,Y0+6,AA+K*0.25,1.2,0)
          NEXT K
        END IF
      ELSE IF TY=5 THEN
        'MINE: DRIFTS, BLINKS, THEN BURSTS
        'ON ITS OWN (THAT COUNTS AS AN
        'ESCAPE)
        ADD QY(E),0.5
        IF G>170 THEN SPRITE 21+E PAL 3-(G\4) MOD 2
        IF G=230 THEN
          CALL MINEB(X0,Y0)
          QY(E)=200
        END IF
      ELSE IF TY=6 THEN
        'STATION TURRET: RIDES THE STATION,
        'FIRING AIMED STREAMS
        ADD QY(E),1
        K=G MOD 80
        IF K=30 THEN
          CALL AIM(X0,Y0)
          QV(E)=AA
        END IF
        IF K>=30 AND K<54 AND K MOD 6=0 THEN CALL FIRE(X0,Y0+6,QV(E),1.3,0)
      ELSE IF TY>=7 AND TY<=8 THEN
        'ASTEROIDS DRIFT
        ADD QX(E),QU(E)
        ADD QY(E),0.6-(TY=8)*0.4
        INC NRK
      ELSE IF TY=9 THEN
        'AMBUSHER: CLIMBS FAST, SLOWS,
        'SHOOTS TWICE, LEAVES OFF THE TOP
        ADD QY(E),-MAX(0.7,3-G*0.06)
        IF G=25 OR G=60 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0,AA,1.3,0)
        END IF
      ELSE IF TY=10 THEN
        'LIGHTNING TURRET: FLICKERS AS IT
        'CHARGES, THEN FIRES A FAST BOLT
        ADD QY(E),0.5
        K=G MOD 120
        SPRITE 21+E PAL 3+(K>=60 AND (G\3) MOD 2=1)*-1
        IF K=100 THEN
          FOR J=0 TO 5
            CALL FIRE(X0,Y0+4+J*7,PI/2,3.2,0)
          NEXT J
          PLAY 3,80,8 SOUND 7
        END IF
      ELSE IF TY=11 THEN
        'DRAIN ORB: WEAVES DOWN FIRING
        'SHIELD-DRAINING SHOTS
        ADD QY(E),0.7
        QX(E)=QU(E)+SIN(G*0.04)*20
        IF G MOD 50=25 THEN
          CALL AIM(X0,Y0)
          FOR K=-1 TO 1
            CALL FIRE(X0,Y0,AA+K*0.3,1.1,7)
          NEXT K
        END IF
      ELSE IF TY=12 THEN
        'ALIEN POD: SINKS, RELEASING
        'SWARMERS UNTIL IT IS DESTROYED
        ADD QY(E),0.4
        IF G MOD 45=30 THEN
          RX=QX(E)+4
          RY=QY(E)+8
          CALL SPAWN(13,RX,0)
          IF LE>=0 THEN
            QX(LE)=RX
            QY(LE)=RY
          END IF
        END IF
      ELSE IF TY=13 THEN
        'SWARMER: HOMES FOR A SECOND
        IF G<60 THEN
          CALL AIM(X0-4,Y0-4)
          QU(E)=QU(E)*0.92+COS(AA)*0.22
          QV(E)=QV(E)*0.92+SIN(AA)*0.22
        END IF
        ADD QX(E),QU(E)
        ADD QY(E),QV(E)
      ELSE IF TY=4 THEN
        ADD QY(E),0.35
        X0=QX(E)+12
        Y0=QY(E)+12
        IF G MOD 90=45 THEN
          FOR K=0 TO 7
            CALL FIRE(X0,Y0,K*PI/4+G,0.7,0)
          NEXT K
        END IF
        IF G MOD 60=0 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0-6,Y0+8,AA,1,1)
          CALL FIRE(X0+6,Y0+8,AA,1,1)
        END IF
      END IF
      'LEFT THE SCREEN ALIVE: ESCAPED
      IF QY(E)>132 OR QY(E)<-30 OR QX(E)<-26 OR QX(E)>170 OR (TY=3 AND G>260 AND QY(E)<-18) THEN
        QA(E)=0
        SPRITE OFF 21+E
        INC ESC
        MUL=MAX(1,MUL-1)
        PLAY 3,30,6 SOUND 6
      ELSE
        SPRITE 21+E,QX(E),QY(E),
        INC QL
      END IF
    END IF
  NEXT E
END SUB

SUB HURTE(E,D)
  ADD QH(E),-D
  IF QH(E)<=0 THEN
    QA(E)=0
    SPRITE OFF 21+E
    TY=QT(E)
    IF TY=4 OR TY=7 THEN
      CALL FIRE(QX(E)+12,QY(E)+12,0,0,6)
    ELSE
      CALL FIRE(QX(E)+8,QY(E)+8,0,0,6)
    END IF
    IF TY=5 THEN CALL MINEB(QX(E)+8,QY(E)+8)
    IF TY=7 THEN
      'A BIG ASTEROID SPLITS IN TWO
      RX=QX(E)+4
      RY=QY(E)+4
      FOR K=-1 TO 1 STEP 2
        CALL SPAWN(8,RX,0)
        IF LE>=0 THEN
          QX(LE)=RX
          QY(LE)=RY
          QU(LE)=K*0.9
          SPRITE 21+LE,RX,RY,
        END IF
      NEXT K
    END IF
    'FAST KILLS RAISE THE MULTIPLIER
    'MORE
    V=0.1
    IF QG(E)<QK(TY) THEN V=0.25
    CALL KILLSCORE(QB(TY),V)
    INC KIL
    PLAY 3,24+RND(6),14 SOUND 5
    'MAELSTROM: EVERY KILL SHOOTS BACK
    IF MODE=4 THEN
      X0=QX(E)+8
      Y0=QY(E)+8
      CALL AIM(X0,Y0)
      CALL FIRE(X0,Y0,AA,1,0)
    END IF
  ELSE
    PLAY 3,50,1 SOUND 6
  END IF
END SUB

'A MINE BURSTS INTO A RING
SUB MINEB(X0,Y0)
  FOR K=0 TO 5
    CALL FIRE(X0,Y0,K*PI/3+0.5,0.9,0)
  NEXT K
  PLAY 3,30,10 SOUND 5
END SUB

SUB KILLSCORE(B,V)
  ADD SC,INT(B*MUL)
  OLD=INT(MUL)
  MUL=MIN(9.9,MUL+V)
  IF INT(MUL)>OLD THEN PLAY 3,68+INT(MUL)*2,8 SOUND 4
  IF MUL>MMAX THEN MMAX=MUL
  LKT=0
  'HIDDEN 1UP COUNTER (NOT IN
  'MAELSTROM)
  IF MODE<>4 THEN INC ONEUP
  IF ONEUP>=150 THEN
    ONEUP=0
    INC LIVES
    CALL HUD
    PLAY 2,90,30 SOUND 4
  END IF
END SUB

'BOSS: THE LEFT HALF IS SPRITES 3
'AND 5, THE RIGHT HALF THE SAME ART
'FLIPPED (4 AND 6)
SUB BOSSMOVE
  IF BYO<14 THEN
    ADD BYO,0.5
  ELSE IF PHT=0 THEN
    BV=-1
  END IF
  IF AK=2 THEN
    CALL TWINMOVE
    EXIT SUB
  END IF
  IF AK=3 THEN
    CALL THUNDMOVE
    EXIT SUB
  END IF
  IF AK=5 THEN
    CALL SOVMOVE
    EXIT SUB
  END IF
  BXO=56+SIN(T*0.019*(1+PH*0.3))*46
  Y=BYO
  IF PH=2 THEN Y=BYO-6+SIN(T*0.05)*3
  'CYCLONE LANCER AND THE TEMPEST
  'CHARGE DOWN
  IF PH=3 AND (AK=4 OR AK=6) THEN Y=BYO+MAX(0,SIN(T*0.025))*44
  SPRITE 3,BXO,Y,112
  SPRITE 4,BXO+24,Y,112
  SPRITE 5,BXO,Y+24,115
  SPRITE 6,BXO+24,Y+24,115
  GX=BXO+24
  GY=Y+24
END SUB

'TWIN SQUALL: TWO UNITS CIRCLE EACH
'OTHER (SPRITES 3+5 AND, MIRRORED,
'4+6). THE SURVIVOR CIRCLES FASTER,
'THEN HOLDS THE MIDDLE
SUB TWINMOVE
  IF TWT>0 THEN DEC TWT
  W=0.02
  IF PH>1 THEN W=0.045
  ADD TA,W
  FOR U=0 TO 1
    IF UH(U)>0 THEN
      S=1-2*U
      X0=68-COS(TA)*44*S
      Y0=BYO+SIN(TA)*12*S
      IF PH=3 THEN
        X0=68+SIN(T*0.05)*30
        Y0=BYO+SIN(T*0.11)*4
      END IF
      ADD UX(U),(X0-UX(U))*0.08
      ADD UY(U),(Y0-UY(U))*0.08
      SPRITE 3+U,UX(U),UY(U),112
      SPRITE 5+U,UX(U)+4,UY(U)+24,115
    END IF
  NEXT U
END SUB

'THUNDERHEAD: A BATTLESHIP OF BG0
'TILES MOVED BY SCROLLING. FOUR
'TURRET SPRITES (UNITS) SIT ON IT,
'THEN THE CORE (SPRITE 3). OPEN, THE
'CORE'S LINES WOBBLE IN THE HEAT
SUB THUNDMOVE
  IF HDR=0 THEN
    BG 0
    BG COPY 0,0,16,8 TO 2,0
    HDR=-1
  END IF
  HX=INT(SIN(T*0.012)*10)
  HY=INT(BYO-2)
  HSX=(256-HX) AND 255
  HSY=(256-HY) AND 255
  SCROLL 0,HSX,HSY
  GX=HX+80
  GY=HY+34
  IF PH=1 THEN
    FOR U=0 TO 3
      IF UH(U)>0 THEN
        UX(U)=HX+TUX(U)-8
        UY(U)=HY+TUY(U)-8
        SPRITE 3+U,UX(U),UY(U),119
      END IF
    NEXT U
  ELSE
    NU=0
    SPRITE 3,GX-8,GY-8,121-(PH=3)*2
    WOB=PH=3
    WY0=GY-12
    WY1=GY+12
  END IF
END SUB

'STORM SOVEREIGN: A 48X48 STORM-EYE
'CORE (ONE QUARTER, FLIPPED INTO
'SPRITES 3-6). PHASE 2 SENDS OUT
'THREE ORBITING SHIELDS, ENEMIES OF
'TYPE 14 THAT FIRE AS BOSS UNITS;
'THE CORE IS SHIELDED UNTIL THEY
'FALL. PHASE 3 BORROWS EACH EARLIER
'BOSS'S FINAL PHASE IN TURN
SUB SOVMOVE
  BXO=56+SIN(T*0.013)*36
  Y=BYO+SIN(T*0.031)*4
  SPRITE 3,BXO,Y,112
  SPRITE 4,BXO+24,Y,112
  SPRITE 5,BXO,Y+24,112
  SPRITE 6,BXO+24,Y+24,112
  GX=BXO+24
  GY=Y+24
  IF PH=2 THEN
    IF UB=0 THEN
      NU=3
      UB=4
      HREST=TH3
      UOX=8
      UOY=8
      FOR U=0 TO 2
        CALL SPAWN(14,GX,0)
        SV(U)=LE
      NEXT U
    END IF
    HP=HREST
    FOR U=0 TO 2
      E=SV(U)
      UH(U)=0
      IF E>=0 THEN
        IF QA(E) AND QT(E)=14 THEN UH(U)=QH(E)
      END IF
      IF UH(U)>0 THEN
        A=T*0.03+U*2.094
        QX(E)=GX-8+COS(A)*40
        QY(E)=GY-8+SIN(A)*30
        UX(U)=QX(E)
        UY(U)=QY(E)
        ADD HP,UH(U)
      END IF
    NEXT U
  ELSE IF PH=3 THEN
    NU=0
    K=1+(T\300) MOD 4
    IF K<>SVK THEN
      SVK=K
      P=ROM(4)+PEEKW(ROM(4)+1+(K-1)*2)+9
      FOR J=1 TO 2
        P=P+1+PEEK(P)*11
      NEXT J
      PHN(3)=PEEK(P)
      PHA(3)=P+1
    END IF
  END IF
END SUB

'BOSS ATTACKS ARE ROWS IN ROM #4, 11
'BYTES EACH: PERIOD, OFFSET, SHAPE
'(0 FAN, 1 RING, 2 SPAWN), COUNT,
'STEP X100, SPEED X20, BULLET OR
'ENEMY TYPE, X+64 AND Y+64 FROM THE
'BOSS CENTRE, AIM (0 DOWN, 1 AT THE
'PLAYER, 2 ROTATING, 3 FIXED AT TURN
'FROM DOWN), TURN X100+128. A ROW
'FIRES WHEN (T+OFFSET) MOD PERIOD=0.
'A BOSS MADE OF NU UNITS RUNS EACH
'ROW FROM EVERY LIVING UNIT: TWIN
'SQUALL'S RIGHT UNIT MIRRORED (MX=-1),
'THUNDERHEAD'S TURRETS STAGGERED
SUB BOSSFIRE
  FOR U=0 TO MAX(0,NU-1)
    OK=-1
    UO=0
    IF NU THEN
      OK=UH(U)>0
      GX=UX(U)+UOX
      GY=UY(U)+UOY
      IF AK=2 THEN MX=1-2*U ELSE UO=U*15
    END IF
    IF OK THEN
      FOR R=0 TO PHN(PH)-1
        P=PHA(PH)+R*11
        IF (T+PEEK(P+1)+UO) MOD PEEK(P)=0 THEN CALL ATTACK(P,PHI(PH)+R+U*10)
      NEXT R
    END IF
  NEXT U
END SUB

SUB ATTACK(P,RI)
  N=PEEK(P+3)
  X0=GX+(PEEK(P+7)-64)*MX
  Y0=GY+PEEK(P+8)-64
  SH=PEEK(P+2)
  IF SH=2 THEN
    FOR K=1 TO N
      CALL SPAWN(PEEK(P+6),X0,0)
    NEXT K
    EXIT SUB
  END IF
  AM=PEEK(P+9)
  TU=(PEEK(P+10)-128)/100*MX
  B0=PI/2
  IF AM=1 THEN
    CALL AIM(X0,Y0)
    B0=AA
  ELSE IF AM=2 THEN
    B0=ROT(RI)
  ELSE IF AM=3 THEN
    B0=PI/2-TU
  END IF
  ADD ROT(RI),TU
  'FANS ARE CENTRED ON THE AIM, RINGS
  'GO ALL THE WAY ROUND FROM IT
  ST=PEEK(P+4)/100
  OF=(N-1)/2
  IF SH=1 THEN
    ST=2*PI/N
    OF=0
  END IF
  SPD=PEEK(P+5)/20
  TY=PEEK(P+6)
  IF SH>=3 THEN
    'LANCE: A LINE OF BULLETS STEP PX
    'APART, TRAILING BACK FROM THE GUN.
    'WALL: THE LINE SIDE-ON
    ST=PEEK(P+4)
    CX=-COS(B0)
    CY=-SIN(B0)
    KO=0
    IF SH=4 THEN
      CX=-CY
      CY=COS(B0)
      KO=(N-1)/2
    END IF
    FOR K=0 TO N-1
      CALL FIRE(X0+CX*(K-KO)*ST,Y0+CY*(K-KO)*ST,B0,SPD,TY)
    NEXT K
    PLAY 3,70,6 SOUND 7
    EXIT SUB
  END IF
  FOR K=0 TO N-1
    CALL FIRE(X0,Y0,B0+(K-OF)*ST,SPD,TY)
  NEXT K
END SUB

'BOSS RECORD FROM ROM #4: HP, PHASE
'2 AND 3 THRESHOLDS (2 BYTES EACH),
'PALETTE, THEN PER PHASE A ROW COUNT
'AND ITS ATTACK ROWS
SUB LOADBOSS(B)
  P=ROM(4)+PEEKW(ROM(4)+1+(B-1)*2)
  HP=PEEKW(P)
  HPMAX=HP
  TH2=PEEKW(P+2)
  TH3=PEEKW(P+4)
  P1=PEEK(P+6)
  P2=PEEK(P+7)
  P3=PEEK(P+8)
  P=P+9
  RI=0
  FOR K=1 TO 4
    PHN(K)=PEEK(P)
    PHA(K)=P+1
    PHI(K)=RI
    ADD RI,PHN(K)
    P=P+1+PHN(K)*11
  NEXT K
  'TWIN SQUALL'S RIGHT-UNIT SPINS
  'START MIRRORED
  FOR K=0 TO 39
    ROT(K)=PI*(K>9 AND K<20 AND B=2)*-1
  NEXT K
  MX=1
  TA=0
  TWT=0
  TWB=0
  HDR=0
  'UNITS: HEALTH EACH, HEALTH LEFT
  'AFTER THEM, AIM POINT IN THE SPRITE
  NU=0
  UB=0
  SVK=0
  HREST=0
  UOX=12
  UOY=16
  IF B=2 THEN
    NU=2
    UH(0)=HP/2
    UH(1)=HP/2
  ELSE IF B=3 THEN
    NU=4
    HREST=TH2
    UOX=8
    UOY=8
    FOR K=0 TO 3
      UH(K)=(HP-TH2)/4
    NEXT K
  END IF
  UX(0)=24
  UX(1)=112
  UY(0)=-48
  UY(1)=-48
END SUB

'NEXT SPAWN ROW OF THE AREA SCRIPT:
'FRAME (2 BYTES, -1 ENDS), TYPE,
'X+64, COUNT, GAP, X STEP+128
SUB NEXTROW
  NWT=PEEKW(AP)
  NTY=PEEK(AP+2)
  NXX=PEEK(AP+3)-64
  NN=PEEK(AP+4)
  NDT=PEEK(AP+5)
  NDX=PEEK(AP+6)-128
  AP=AP+7
END SUB

'A LENGTH-PREFIXED STRING AT AP
SUB RSTR
  RS$=""
  N=PEEK(AP)
  FOR K=1 TO N
    RS$=RS$+CHR$(PEEK(AP+K))
  NEXT K
  AP=AP+1+N
END SUB

'SECTOR ART: 48 CHARACTERS (ENEMIES
'AND BOSS) INTO 112-159
SUB LOADSECTOR(N)
  IF N=SECT THEN EXIT SUB
  SECT=N
  'FIRST THE CHARACTER OF EACH ENEMY
  'TYPE IN THIS SECTOR
  A=ROM(4+N)
  FOR K=0 TO 15
    QCH(K)=PEEK(A+K)
  NEXT K
  COPY A+16,768 TO $8000+112*16
END SUB

'BACKDROP E FROM ROM #10'S TABLE:
'3 COLOURS (PALETTE
'5), TILE COUNT, TILES, THEN A MAP.
'THE TILES FILL THE FREE CHARACTER
'RANGES IN BSLOTS, IN ORDER
SUB LOADBACK(E)
  A=ROM(10)+PEEKW(ROM(10)+1+(E-1)*2)
  PALETTE 5,,PEEK(A),PEEK(A+1),PEEK(A+2)
  N=PEEK(A+3)
  P=A+4
  RESTORE BSLOTS
  WHILE N>0
    READ C0,CN
    M=MIN(CN,N)
    COPY P,M*16 TO $8000+C0*16
    ADD P,M*16
    ADD N,-M
  WEND
  BG SOURCE P
  BSP=P
END SUB
BSLOTS:
DATA 160,32,44,4,70,6,86,6,102,6

'H IS THE BOSS SPRITE THAT WAS HIT.
'A BOSS MADE OF UNITS TAKES DAMAGE ON
'THE UNIT THAT WAS HIT
SUB BOSSHIT(D,H)
  ADD SC,INT(5*D*MUL)
  FL=2
  IF T MOD 4=0 THEN PLAY 3,40,1 SOUND 6
  IF NU=0 THEN
    ADD HP,-D
    EXIT SUB
  END IF
  'UNITS START AT SPRITE 3+UB (BELOW
  'THAT, A SHIELDED CORE)
  IF H-3<UB THEN EXIT SUB
  U=(H-3-UB) MOD NU
  IF UH(U)<=0 THEN EXIT SUB
  ADD UH(U),-D
  IF UH(U)<=0 THEN
    UH(U)=0
    LU=U
    SPRITE OFF 3+U+UB
    IF AK=2 THEN SPRITE OFF 5+U
    FOR K=0 TO 5
      CALL FIRE(UX(U)+UOX-8+RND(16),UY(U)+UOY-8+RND(16),RND*2*PI,0.3,6)
    NEXT K
    PLAY 3,10,30 SOUND 7
    'TWIN SQUALL: THE SURVIVOR SPEEDS
    'UP. DOWN BOTH WITHIN 3 SECONDS FOR
    'THE TWIN BONUS
    IF AK=2 THEN
      IF UH(1-U)>0 THEN
        PH=2
        TWT=180
        ADD SC,5000
        CALL CANCEL
      ELSE IF TWT>0 THEN
        TWB=30000
      END IF
    END IF
  END IF
  HP=HREST
  FOR K=0 TO NU-1
    ADD HP,UH(K)
  NEXT K
END SUB

SUB PHASEUP(P)
  PH=P
  BV=0
  PHT=70
  ADD SC,5000
  CALL CANCEL
  FL=2
  PLAY 3,20,40 SOUND 5
END SUB

SUB PLAYERDIE
  'TRAINING: NO LIVES LOST
  IF MODE<>1 THEN DEC LIVES
  MUL=1
  'DEATHS ALSO FILL THE 1UP COUNTER
  ADD ONEUP,40
  INV=150
  DEAD=45
  SHON=0
  SPRITE OFF 2
  PLAY 3,8,40 SOUND 5
  CALL CLEARB
  CALL FIRE(PX+8,PY+8,0,0,6)
  FOR K=0 TO 7
    CALL FIRE(PX+8,PY+8,K*PI/4,1.1,5)
  NEXT K
  SPRITE OFF 0 TO 1
  CALL HUD
END SUB

'HIGH SCORES IN PERSISTENT RAM:
'$E010+TABLE*35+RANK*7 = SCORE (4
'BYTES) + 3 LETTERS. TABLE 0 ARCADE,
'1 MAELSTROM. $E005 UNLOCKS, $E006 THE
'FURTHEST SECTOR REACHED
SUB HSINIT
  IF PEEK($E004)<>22 THEN
    FOR D=0 TO 1
      FOR R=0 TO 4
        A=$E010+D*35+R*7
        POKEL A,(5-R)*100000
        POKE A+4,74
        POKE A+5,80
        POKE A+6,65
      NEXT R
    NEXT D
    POKE $E005,0
    POKE $E006,1
    POKE $E004,22
  END IF
  UNL=PEEK($E005)
  MXS=PEEK($E006)
END SUB

'TITLE PANEL: 0 CONTROLS (WITH GALE
'KNIGHT), 1 THE MODE'S HIGH SCORES
SUB TPANEL(P)
  BG 0
  BG FILL 0,5 TO 19,13 CHAR 0
  IF P=0 THEN
    PAL 1
    CALL CTEXT(12,"A SHOT  B SPREAD")
    CALL CTEXT(13,"A+B SHIELD")
  ELSE
    SPRITE OFF 3 TO 6
    PAL 3
    IF TB THEN CALL CTEXT(6,"MAELSTROM BEST") ELSE CALL CTEXT(6,"BEST SCORES")
    FOR R=0 TO 4
      A=$E010+TB*35+R*7
      PAL 6
      NUMBER 3,8+R,R+1,1
      TEXT 6,8+R,CHR$(PEEK(A+4))+CHR$(PEEK(A+5))+CHR$(PEEK(A+6))
      NUMBER 11,8+R,PEEKL(A),6
    NEXT R
  END IF
END SUB

'STEP TO THE NEXT UNLOCKED MODE
SUB NEXTMODE(DR)
  FOR K=1 TO 5
    MODE=(MODE+DR+5) MOD 5
    IF MODE=0 OR (UNL AND MB(MODE)) THEN EXIT SUB
  NEXT K
END SUB

SUB WAITA
  WAIT 60
  DO
    CALL STEPSTARS
    IF BUTTON TAP(0,0) THEN EXIT
    WAIT VBL
  LOOP
END SUB

'ENDINGS: 1 NORMAL, 2 GOOD (90%
'DESTROYED), 3 TRUE (THE EYE OPENED
'AND FELL). THE EARTH WAITS BELOW
SUB ENDING(K)
  CALL RESETPLAY
  CALL DRAWBACK(1,3)
  IF K=3 THEN PALETTE 5,,16,32,48
  RESTORE ENDTXT
  FOR J=1 TO K
    READ N
    FOR I=1 TO N
      READ M$
      IF J=K THEN
        IF K=3 THEN PAL 3 ELSE PAL 6
        CALL CTEXT(9+I,M$)
        FOR F=1 TO 50
          CALL STEPSTARS
          WAIT VBL
        NEXT F
      END IF
    NEXT I
  NEXT J
  PAL 4
  IF K=3 THEN CALL CTEXT(17,"TO BE CONTINUED?") ELSE CALL CTEXT(17,"THE END")
  CALL WAITA
  CALL RESETPLAY
  PAL 1
  CALL CTEXT(6,"THANKS FOR PLAYING")
  PAL 6
  CALL CTEXT(8,"BY "+AUTHOR$)
  CALL WAITA
END SUB
ENDTXT:
DATA 5,"THE SOVEREIGN","IS GONE.","","THE STORM WILL","RETURN SOMEDAY."
DATA 5,"THE SOVEREIGN","IS GONE.","","CLEAR SKIES","ALL THE WAY HOME."
DATA 6,"THE EYE OPENS","ONE LAST TIME","AND SHOWS YOU","WHERE STORMS BEGIN:"
DATA "THE BLUE WORLD","YOU CALL HOME."

'PAUSE MENU IN THE HUD ROW
SUB PAUSEMENU
  STOP
  SEL=0
  QUIT=0
  OSEL=-1
  DO
    IF UP TAP(0) OR LEFT TAP(0) THEN SEL=0
    IF DOWN TAP(0) OR RIGHT TAP(0) THEN SEL=1
    IF SEL<>OSEL THEN
      OSEL=SEL
      BG 1
      BG FILL 0,0 TO 19,0 CHAR 0
      PAL 4
      IF SEL=0 THEN
        TEXT 0,0,"PAUSED >RESUME  QUIT"
      ELSE
        TEXT 0,0,"PAUSED  RESUME >QUIT"
      END IF
    END IF
    IF PAUSE THEN EXIT
    IF BUTTON TAP(0,0) THEN
      IF SEL=1 THEN QUIT=-1
      EXIT
    END IF
    WAIT VBL
  LOOP
  IF QUIT=0 THEN
    MUSIC SNG
  END IF
  CALL HUD
END SUB

'GAME OVER: 10 SECONDS TO CONTINUE.
'A CARRIES ON (SCORE RESETS), B QUITS
SUB CONTPROMPT
  STOP
  PLAY 3,40,30 SOUND 5
  FOR CD=9 TO 0 STEP -1
    BG 1
    BG FILL 0,0 TO 19,0 CHAR 0
    PAL 4
    TEXT 0,0,"CONTINUE  PRESS A"
    NUMBER 18,0,CD,1
    FOR F=1 TO 60
      IF BUTTON TAP(0,0) THEN
        INC CNT
        LIVES=3
        SC=0
        MUL=1
        CALL HUD
        PLAY 2,96,10 SOUND 4
        MUSIC SNG
        EXIT SUB
      END IF
      IF BUTTON TAP(0,1) THEN EXIT SUB
      CALL STEPSTARS
      WAIT VBL
    NEXT F
  NEXT CD
END SUB

