'=================================
' HAILSTORM II: EYE OF THE TEMPEST
' SEQUEL TO HAILSTORM, IN THE STYLE
' OF JUDGEMENT SILVERSWORD
' PROTOTYPE: 3 AREAS AND A BOSS
'
' A   = FORWARD SHOT (NARROW,STRONG)
' B   = SPREAD SHOT (WIDE, WEAK)
' A+B = SHIELD. IT ABSORBS BULLETS,
'   BUT EACH ONE DRAINS IT AND IT
'   SHRINKS AS IT WEAKENS. AT 0% IT
'   SHATTERS. FIRING RECHARGES IT.
'
' SCORING: KILLS RAISE THE
' MULTIPLIER (MORE FOR FAST KILLS).
' IT DECAYS QUICKLY, AND EVERY
' ENEMY THAT ESCAPES KNOCKS IT DOWN
'
' SPRITES: 0 HITBOX, 1 SHIP,
' 2 SHIELD, 3-6 BOSS, 7-20 SHOTS,
' 21-32 ENEMIES, 33-63 BULLETS
'=================================

GLOBAL PX,PY,SC,HI,LIVES,INV,DEAD,HP,HPMAX,PH,PHT,T,BV,FL
GLOBAL BXO,BYO,GX,GY,NB,NSS,A1,RO,AA
GLOBAL SY1,RA,RB,WL,LHB,GOD,TGR
GLOBAL SHG,SHBRK,SHON,SHSZ,MUL,MMAX,LKT
GLOBAL QL,KIL,TOT,ESC,ONEUP,AREA,PLY,PLON,QUIT,SY0,NEAR

DIM GLOBAL BX(63),BY(63),BDX(63),BDY(63),BA(63),BK(63),BT(63),BAG(63)
DIM GLOBAL TC(6),TZ(6),HS(6),TP(6),TN(6),SR2(6),EXC(2)
DIM GLOBAL SHX(20),SHY(20),SHVX(20),SHVY(20),SHD(20),SHA(20)
DIM GLOBAL QA(11),QX(11),QY(11),QU(11),QV(11),QH(11),QT(11),QG(11)
DIM GLOBAL QB(4),QK(4),SPX(2),SPY(2),SHC(2),SHS(2),SHO(2),SHRT(2)
DIM GLOBAL GA(7),GB(7)

'BULLET TYPES: CHAR,SIZE,HALF,PAL,
'BULLETS PER SPRITE
'0 SMALL 1 BIG 2 QUAD 3 TRI 4 RING
'5 SPARK, 6 EXPLOSION (HARMLESS)
FOR I=0 TO 6
  READ TC(I),TZ(I),HS(I),TP(I),TN(I)
NEXT I
DATA 12,0,4,2,1,13,0,4,7,1,32,1,8,2,4
DATA 34,1,8,2,3,64,2,12,7,8,14,0,4,3,0
DATA 42,1,8,4,0
EXC(0)=42
EXC(1)=44
EXC(2)=46

'ENEMIES: BASE SCORE, FRAMES THAT
'STILL COUNT AS A FAST KILL
'0 DART 1 SIDE FIGHTER 2 ORB
'3 GUNSHIP 4 HEAVY CARRIER
FOR I=0 TO 4
  READ QB(I),QK(I)
NEXT I
DATA 100,50,150,40,300,90,800,150,2500,240

'SPREAD SHOT: THREE PELLETS
FOR I=0 TO 2
  A=(I-1)*0.45
  SPX(I)=SIN(A)*4.5
  SPY(I)=-COS(A)*4.5
NEXT I

'SHIELD SIZES (SMALL, MID, BIG):
'CHAR, SPRITE SIZE, OFFSET, RADIUS
FOR I=0 TO 2
  READ SHC(I),SHS(I),SHO(I),SHRT(I)
NEXT I
DATA 116,1,0,8,76,2,-4,12,112,3,-8,16

'TITLE LOGO GRADIENT
FOR I=0 TO 7
  READ GA(I),GB(I)
NEXT I
DATA 32,48,48,52,52,56,56,60,60,62,56,60,52,56,48,52

'SET GODDBG=1 FOR AN INVINCIBLE TEST
'RUN, FIRSTAREA=4 TO START AT BOSS
GODDBG=0
FIRSTAREA=1

GAMEPAD 1
PAUSE OFF
HI=PEEKL($E000)
VOLUME 2,5,3
VOLUME 3,10,3

CALL SETUPSTARS
CALL STEPSTARS
ON RASTER CALL RAS

'---------------------------------
TITLE:
STOP
CALL RESETPLAY
CALL SETUPSTARS
PH=0
CALL HUD
BG 0
PAL 7
CALL CTEXT(2,"H A I L S T O R M")
PAL 4
CALL CTEXT(3,"I I")
PAL 6
CALL CTEXT(4,"EYE OF THE TEMPEST")
PAL 1
CALL CTEXT(12,"A SHOT  B SPREAD")
CALL CTEXT(13,"A+B SHIELD")
PAL 6
CALL CTEXT(15,"PROTOTYPE")
PALETTE 3,,17,38,56
SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
TGR=1
DO
  CALL STEPSTARS
  INC T
  TGR=T+1
  Y=45+SIN(T*0.04)*1.5
  SPRITE 3,56,Y,70
  SPRITE 4,80,Y,70
  SPRITE 5,56,Y+24,73
  SPRITE 6,80,Y+24,73
  PAL 4
  IF T MOD 60<40 THEN
    CALL CTEXT(14,"PRESS A")
  ELSE
    CALL CTEXT(14,"       ")
  END IF
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP
TGR=0
PLAY 2,96,10 SOUND 4

'---------------------------------
GAME:
SC=0
LIVES=3
MUL=1
MMAX=1
ONEUP=0
TKIL=0
TTOT=0
GOD=GODDBG
AREA=FIRSTAREA

STAGE:
CALL RESETPLAY
PH=1
PHT=0
KIL=0
TOT=0
ESC=0
SHG=100
SHBRK=0
PX=72
PY=100
INV=90
DEAD=0
BV=0
FL=0
LKT=0
WV=1
BDRAWN=0
BTM=0
WRN=0
NWT=0
SQN=0
WVT=0
SPRITE 1 PAL 1 SIZE 1
SPRITE 0 PAL 1 PRIO 1
SPRITE 2 PAL 7
FOR I=7 TO 20
  SPRITE I PAL 4 SIZE 0
NEXT I
IF AREA<4 THEN
  IF AREA=1 THEN RESTORE A1
  IF AREA=2 THEN RESTORE A2
  IF AREA=3 THEN RESTORE A3
  READ AN$,ALEN
  P1=32
  P2=52
  P3=60
  'KEEP THE SONG GOING BETWEEN AREAS
  IF MUSIC(3)=0 THEN MUSIC 0
ELSE
  AN$="GALE KNIGHT"
  HP=720
  HPMAX=HP
  BXO=56
  BYO=-48
  P1=17
  P2=38
  P3=56
  SPRITE 3 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 4 PAL 3 SIZE 2 FLIP 1,0
  SPRITE 5 PAL 3 SIZE 2 FLIP 0,0
  SPRITE 6 PAL 3 SIZE 2 FLIP 1,0
  MUSIC 4
END IF
PALETTE 3,,P1,P2,P3
CALL HUD
'AREA CARD (IN AREA 1 IT SITS ABOVE
'THE EARTH, WHICH STARTS SCROLLED)
TR=6
IF AREA=1 THEN
  CALL DRAWPLANET
  TR=4+PLY\8
END IF
BG 0
PAL 3
IF AREA<4 THEN
  CALL CTEXT(TR,"AREA "+CHR$(48+AREA))
  PAL 6
  CALL CTEXT(TR+2,AN$)
  MSGT=120
ELSE
  PAL 4
  CALL CTEXT(TR,"WARNING")
  PAL 6
  CALL CTEXT(TR+2,"HERE COMES")
  PAL 4
  CALL CTEXT(TR+3,"[ "+AN$+" ]")
  MSGT=150
  WRN=150
END IF

DO
  INC T
  CALL STEPSTARS

  '--- PAUSE MENU
  IF PAUSE THEN
    CALL PAUSEMENU
    IF QUIT THEN EXIT
  END IF

  '--- INPUT: A FORWARD, B SPREAD,
  '--- BOTH = SHIELD
  IA=BUTTON(0,0)
  IB=BUTTON(0,1)
  SHON=0
  IF IA AND IB AND DEAD=0 AND SHBRK=0 AND SHG>0 THEN SHON=-1

  IF DEAD=0 THEN
    IF SHON THEN CALL SHIPMOVE(1.2) ELSE CALL SHIPMOVE(1.7)
    IF SHON=0 THEN
      IF IA THEN
        IF T MOD 5=0 THEN
          CALL SHOT(PX+4,PY-6,0,-5,3,10)
          PLAY 2,72,2 SOUND 3
        END IF
      ELSE IF IB THEN
        IF T MOD 7=0 THEN
          FOR K=0 TO 2
            CALL SHOT(PX+4,PY-2,SPX(K),SPY(K),1,11)
          NEXT K
          PLAY 2,62,2 SOUND 3
        END IF
      END IF
      'FIRING RECHARGES THE SHIELD
      IF IA OR IB THEN
        SHG=MIN(100,SHG+0.12)
        IF SHBRK AND SHG>=30 THEN
          SHBRK=0
          PLAY 3,80,10 SOUND 4
        END IF
      END IF
    END IF
  END IF

  '--- SHIELD SPRITE: SHRINKS AS IT
  '--- WEAKENS, SHIMMERS BY FLIPPING
  IF SHON THEN
    SZ=0
    IF SHG>33 THEN SZ=1
    IF SHG>66 THEN SZ=2
    IF SZ<>SHSZ THEN CALL SETSHIELD(SZ)
    SPRITE 2,PX+SHO(SZ),PY+SHO(SZ),SHC(SZ)
    SPRITE 2 FLIP (T\4) MOD 2,(T\8) MOD 2
  ELSE
    SPRITE OFF 2
  END IF

  '--- PLAYER SHOTS
  CALL MOVESHOTS(-1)

  '--- PARALLAX: FAST STREAK LAYER ON BG0
  IF NEAR THEN
    SY0=(SY0-4) AND 255
    SCROLL 0,0,SY0
  END IF

  '--- ENEMY BULLETS PULSE SO THEY STAND
  '--- OUT FROM THE BACKGROUND
  IF T MOD 4=0 THEN
    IF T MOD 8=0 THEN
      PALETTE 2,,49,,
      PALETTE 7,,11,,
    ELSE
      PALETTE 2,,54,,
      PALETTE 7,,31,,
    END IF
  END IF

  '--- ENEMY BULLETS (AND THE SHIELD)
  CALL MOVEB

  '--- AREA SCRIPT: A SPAWNER WORKS
  '--- THROUGH THE AREA'S DATA
  IF WV=2 THEN
    INC WVT
    IF SQN>0 THEN
      DEC SQC
      IF SQC<=0 THEN
        CALL SPAWN(SQT,SQX,SQI)
        ADD SQX,SQDX
        INC SQI
        DEC SQN
        SQC=SQD
      END IF
    ELSE IF NWT>=0 AND WVT>=NWT THEN
      SQT=NTY
      SQX=NXX
      SQN=NN
      SQD=NDT
      SQDX=NDX
      SQC=0
      SQI=0
      READ NWT,NTY,NXX,NN,NDT,NDX
    END IF
  END IF
  IF WV=2 OR AREA=4 THEN CALL MOVEE
  IF WV=2 AND NWT<0 AND SQN=0 AND QL=0 THEN EXIT

  '--- THE EARTH SINKS AWAY (AREA 1)
  IF PLON AND T MOD 10=0 THEN
    DEC PLY
    SCROLL 0,0,PLY
    IF PLY<16 THEN
      PLON=0
      CALL NEARON
    END IF
  END IF

  '--- BOSS
  IF AREA=4 THEN
    IF BDRAWN AND HP>0 THEN CALL BOSSMOVE
    IF BV OR PHT>0 THEN INC BTM
    IF BV AND DEAD=0 THEN CALL BOSSFIRE
    IF PH=1 AND HP<=480 THEN
      CALL PHASEUP(2)
    ELSE IF PH=2 AND HP<=240 THEN
      CALL PHASEUP(3)
    END IF
    IF PHT>0 THEN
      DEC PHT
      IF PHT=0 THEN BV=-1
    END IF
    IF HP<=0 THEN EXIT
  END IF
  IF FL=2 THEN PALETTE 3,,52,62,63
  IF FL=1 THEN PALETTE 3,,P1,P2,P3
  IF FL>0 THEN DEC FL

  '--- SIREN BEFORE THE BOSS
  IF WRN>0 THEN
    DEC WRN
    IF WRN MOD 30=29 THEN PLAY 3,62,14 SOUND 4
    IF WRN MOD 30<15 AND WRN>0 THEN
      PALETTE 0,16,,,
    ELSE
      PALETTE 0,1,,,
    END IF
  END IF

  '--- PLAYER SPRITES AND COLLISION
  IF DEAD=0 THEN
    CALL DRAWSHIP
    IF INV=0 AND GOD=0 THEN
      'SPARKS AND EXPLOSIONS SHARE THE
      'SLOTS, SO SKIP HARMLESS HITS
      HITP=0
      H0=21
      WHILE H0<=63
        IF SPRITE HIT(0,H0 TO 63) THEN
          K=BK(HIT)
          IF K=0 OR K=4 THEN
            HITP=-1
            H0=64
          ELSE
            H0=HIT+1
          END IF
        ELSE
          H0=64
        END IF
      WEND
      IF HITP THEN CALL PLAYERDIE
    END IF
    IF INV>0 THEN DEC INV
  ELSE
    DEC DEAD
    IF DEAD=0 THEN
      IF LIVES<0 THEN
        CALL CONTPROMPT
        IF LIVES<0 THEN EXIT
      END IF
      PX=72
      PY=100
      SHG=100
      SHBRK=0
    END IF
  END IF

  '--- MULTIPLIER DECAYS QUICKLY
  INC LKT
  IF LKT>60 AND MUL>1 THEN MUL=MAX(1,MUL-0.015)

  '--- CARD TEXT, THEN WAVES OR BOSS
  IF MSGT>0 THEN
    DEC MSGT
    IF MSGT=0 THEN
      BG 0
      BG FILL 0,TR TO 19,TR+3 CHAR 0
      IF PLON=0 THEN CALL NEARON
      IF AREA<4 THEN
        WV=2
        WVT=0
        SQN=0
        READ NWT,NTY,NXX,NN,NDT,NDX
      ELSE
        BDRAWN=-1
      END IF
    END IF
  END IF

  '--- HUD
  IF T MOD 4=0 THEN
    BG 1
    PAL 6
    NUMBER 0,0,SC,6
    NUMBER 8,0,INT(MUL),1
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    IF SHBRK THEN PAL 3 ELSE PAL 7
    NUMBER 12,0,INT(SHG),3
    IF AREA<4 THEN
      HB=0
      IF WV=2 THEN HB=INT(MIN(1,WVT/ALEN)*20)
    ELSE
      HB=INT(HP*20/HPMAX+0.99)
    END IF
    IF HB<>LHB THEN
      LHB=HB
      PAL 6
      IF HB>0 THEN BG FILL 0,1 TO HB-1,1 CHAR 27
      IF HB<20 THEN BG FILL HB,1 TO 19,1 CHAR 28
    END IF
  END IF

  WAIT VBL
LOOP

'---------------------------------
IF QUIT THEN
  'LET GO OF THE A PRESS THAT CHOSE QUIT
  QUIT=0
  WAIT 10
  GOTO TITLE
END IF
SHON=0
SPRITE OFF 2
ADD TKIL,KIL
ADD TTOT,TOT
IF LIVES<0 THEN
  RES$="GAME OVER"
  GOTO RESULTS
END IF

IF AREA<4 THEN
  'AREA CLEAR: THE TALLY. LEFTOVER
  'BULLETS BURST INTO SPARKS, SHOTS
  'FLY ON, AND THE SHIP CAN STILL MOVE
  CALL CANCEL
  NEAR=0
  BG 0
  CLS 0
  SCROLL 0,0,0
  PLON=0
  DP=100
  IF TOT>0 THEN DP=INT(KIL*100/TOT)
  BONUS=DP*AREA*50
  PERF=(ESC=0) AND (TOT>0)
  IF PERF THEN
    ADD BONUS,10000*AREA
    MUL=MIN(9.9,MUL+1)
  END IF
  ADD SC,BONUS
  PAL 3
  CALL CTEXT(3,"AREA "+CHR$(48+AREA)+" CLEAR")
  PAL 6
  TEXT 4,6,"DESTROY"
  NUMBER 12,6,DP,3
  TEXT 15,6,"%"
  TEXT 4,7,"ESCAPED"
  NUMBER 13,7,ESC,2
  TEXT 4,9,"BONUS"
  NUMBER 10,9,BONUS,6
  IF PERF THEN
    PAL 4
    CALL CTEXT(11,"PERFECT!")
    PLAY 2,90,20 SOUND 4
  END IF
  CALL HUD
  FOR N=0 TO 149
    INC T
    CALL STEPSTARS
    CALL SHIPMOVE(1.7)
    CALL MOVESHOTS(0)
    CALL MOVEB
    CALL DRAWSHIP
    WAIT VBL
  NEXT N
  INC AREA
  GOTO STAGE
END IF

'BOSS DOWN
BV=0
INV=0
CALL CANCEL
STOP
BTB=MAX(0,90-BTM\60)*1000
FOR N=0 TO 119
  CALL STEPSTARS
  IF N MOD 4=0 THEN
    CALL FIRE(BXO+RND(48),BYO+RND(48),RND*2*PI,0.2,6)
    PLAY 3,10+RND(20),12 SOUND 5
  END IF
  IF N=96 THEN
    'FINAL BLAST: A RING OF FIREBALLS
    FOR J=0 TO 7
      CALL FIRE(BXO+24,BYO+24,J*PI/4,0.9,6)
    NEXT J
    PLAY 3,6,40 SOUND 7
  END IF
  IF N MOD 8<4 THEN
    PALETTE 3,,63,63,63
  ELSE
    PALETTE 3,,P1,P2,P3
  END IF
  CALL MOVEB
  IF NEAR THEN
    SY0=(SY0-4) AND 255
    SCROLL 0,0,SY0
  END IF
  INC T
  CALL SHIPMOVE(1.7)
  CALL MOVESHOTS(0)
  CALL DRAWSHIP
  IF N=100 THEN
    SPRITE OFF 3 TO 6
    'VICTORY FANFARE
    TRACK 8,0
    TRACK 9,1
  END IF
  WAIT VBL
NEXT N
CALL CLEARB
ADD SC,BTB
NEAR=0
BG 0
CLS 0
SCROLL 0,0,0
PAL 3
CALL CTEXT(4,AN$+" DOWN")
PAL 6
TEXT 3,7,"TIME BONUS"
NUMBER 14,7,BTB,5
CALL HUD
WAIT 150
RES$="PROTOTYPE CLEAR"

'---------------------------------
RESULTS:
STOP
WAIT 30
CALL RESETPLAY
IF SC>HI THEN
  HI=SC
  POKEL $E000,HI
  NH=-1
ELSE
  NH=0
END IF
PH=0
CALL HUD
BG 0
PAL 3
CALL CTEXT(3,RES$)
PAL 6
CALL CTEXT(6,"SCORE")
NUMBER 7,7,SC,6
DP=100
IF TTOT>0 THEN DP=INT(TKIL*100/TTOT)
TEXT 3,9,"DESTROY"
NUMBER 12,9,DP,3
TEXT 15,9,"%"
TEXT 3,10,"BEST CHAIN X"
NUMBER 15,10,INT(MMAX),1
TEXT 16,10,"."
NUMBER 17,10,INT(MMAX*10) MOD 10,1
PAL 4
IF NH THEN CALL CTEXT(13,"NEW HIGH SCORE!")
WAIT 60
DO
  CALL STEPSTARS
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP
GOTO TITLE

'=================================
'AREA SCRIPTS: NAME, LENGTH, THEN
'FRAME, TYPE, X, COUNT, GAP, X STEP
'TYPES: 0 DART, 1 SIDE FIGHTER (X IS
'ITS HEIGHT; NEGATIVE = FROM THE
'RIGHT), 2 ORB, 3 GUNSHIP, 4 HEAVY
A1:
DATA "LEAVING EARTH",1500
DATA 60,0,30,5,12,0
DATA 220,0,110,5,12,0
DATA 400,1,30,4,16,0
DATA 520,1,-50,4,16,0
DATA 680,3,40,2,40,64
DATA 900,0,20,6,10,20
DATA 1050,2,-16,3,30,0
DATA 1200,1,24,5,10,0
DATA 1260,1,-44,5,10,0
DATA -1,0,0,0,0,0
A2:
DATA "HIGH ORBIT",1700
DATA 60,2,-16,3,30,0
DATA 180,2,160,3,30,0
DATA 320,0,20,6,10,24
DATA 480,3,20,3,30,50
DATA 700,4,68,1,0,0
DATA 760,1,40,4,14,0
DATA 820,1,-60,4,14,0
DATA 1000,0,130,6,10,-20
DATA 1150,3,40,2,40,64
DATA 1300,2,-16,4,25,0
DATA -1,0,0,0,0,0
A3:
DATA "STORM FRONT",1800
DATA 60,1,30,6,8,6
DATA 180,1,-30,6,8,-6
DATA 320,4,20,1,0,0
DATA 360,4,116,1,0,0
DATA 560,0,10,8,8,18
DATA 700,3,20,3,25,50
DATA 900,2,-16,4,25,0
DATA 920,2,160,4,25,0
DATA 1150,0,140,8,8,-18
DATA 1300,4,68,1,0,0
DATA 1340,1,26,5,10,0
DATA 1400,1,-46,5,10,0
DATA -1,0,0,0,0,0

'=================================
'RUNS BEFORE EVERY SCREEN LINE
SUB RAS
  R=RASTER
  IF R=0 THEN
    'HUD LINES: BG1 ONLY, NO SPRITES OR
    'BG0 (BIT 0 SPRITES, 1 BG0, 2 BG1)
    SCROLL 1,0,0
    POKE $FF20,%100
  ELSE IF R=12 THEN
    SCROLL 1,0,RA
    POKE $FF20,%111
  ELSE IF R=WL THEN
    SCROLL 1,0,RB
  END IF
  IF TGR THEN
    IF R>=16 AND R<24 THEN
      K=(R+TGR\2) AND 7
      PALETTE 7,,GA(K),GB(K),63
    END IF
  END IF
END SUB

'STARS: BG1 ROWS 2-31 FORM A 240 PX
'RING. THE RASTER SUB SKIPS THE HUD
'ROWS SO THEY NEVER SCROLL INTO VIEW
SUB STEPSTARS
  SY1=SY1-2
  IF SY1<0 THEN ADD SY1,240
  IF SY1<228 THEN
    RA=SY1+16
  ELSE
    RA=(SY1+32) AND 255
  END IF
  RB=(SY1+32) AND 255
  WL=240-SY1
  IF WL<=12 THEN WL=-1
END SUB

SUB SETUPSTARS
  BG 1
  CLS 1
  PAL 0
  FOR I=0 TO 70
    CELL RND(19),2+RND(29),29+RND(2)
  NEXT I
END SUB

SUB HUD
  BG 1
  BG FILL 0,0 TO 19,1 CHAR 0
  PAL 6
  NUMBER 0,0,SC,6
  IF PH=0 THEN
    TEXT 11,0,"HI"
    NUMBER 14,0,HI,6
  ELSE
    TEXT 7,0,"X"
    NUMBER 8,0,INT(MUL),1
    TEXT 9,0,"."
    NUMBER 10,0,INT(MUL*10) MOD 10,1
    PAL 7
    NUMBER 12,0,INT(SHG),3
    TEXT 15,0,"%"
    PAL 1
    FOR K=0 TO 2
      IF K<LIVES THEN CELL 17+K,0,26 ELSE CELL 17+K,0,0
    NEXT K
  END IF
  LHB=-1
END SUB

SUB CTEXT(ROW,M$)
  TEXT (20-LEN(M$))\2,ROW,M$
END SUB

SUB RESETPLAY
  CALL CLEARB
  FOR I=0 TO 11
    QA(I)=0
  NEXT I
  FOR I=7 TO 20
    SHA(I)=0
  NEXT I
  QL=0
  SPRITE OFF
  PLON=0
  NEAR=0
  BG 0
  CLS 0
  SCROLL 0,0,0
  PALETTE 0,1,,,
  PALETTE 7,,11,47,63
  NB=33
  NSS=7
  A1=0
  RO=0
  T=0
  SHSZ=-1
END SUB

SUB CLEARB
  FOR I=33 TO 63
    BA(I)=0
    BK(I)=0
  NEXT I
  SPRITE OFF 33 TO 63
END SUB

'THE EARTH: A MAP FROM ROM 3 IN BG0
'ROWS 18-29, STARTING HALF ON SCREEN
SUB DRAWPLANET
  BG 0
  BG COPY 0,0,20,12 TO 0,18
  PLY=80
  SCROLL 0,0,PLY
  PLON=-1
END SUB

'NEAR PARALLAX LAYER: SPEED STREAKS
'SCATTERED OVER BG0, WHICH SCROLLS
'TWICE AS FAST AS THE FAR STARS. IT IS
'OFF WHILE BG0 SHOWS TEXT OR THE EARTH
SUB NEARON
  BG 0
  CLS 0
  PAL 0
  FOR I=0 TO 22
    CELL RND(19),RND(31),15+RND(2)
  NEXT I
  NEAR=-1
END SUB

SUB SHIPMOVE(SP)
  IF LEFT(0) THEN ADD PX,-SP
  IF RIGHT(0) THEN ADD PX,SP
  IF UP(0) THEN ADD PY,-SP
  IF DOWN(0) THEN ADD PY,SP
  PX=MAX(0,MIN(144,PX))
  PY=MAX(12,MIN(112,PY))
END SUB

'SHIP FRAME: UPRIGHT OR BANKED (LEFT =
'RIGHT BANK, MIRRORED), FLAME FLICKERS
SUB DRAWSHIP
  FR=(T\3) MOD 2
  IF LEFT(0) THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 1,0
  ELSE IF RIGHT(0) THEN
    SCH=6+FR*2
    SPRITE 1 FLIP 0,0
  ELSE
    SCH=2+FR*2
    SPRITE 1 FLIP 0,0
  END IF
  IF INV>0 AND INV MOD 6<3 THEN
    SPRITE 1,PX,-32,SCH
    SPRITE 0,PX+4,-32,1
  ELSE
    SPRITE 1,PX,PY,SCH
    SPRITE 0,PX+4,PY+4,1
  END IF
END SUB

'MOVE PLAYER SHOTS; CO=0 SKIPS HITS
SUB MOVESHOTS(CO)
  FOR I=7 TO 20
    IF SHA(I) THEN
      ADD SHX(I),SHVX(I)
      ADD SHY(I),SHVY(I)
      IF SHY(I)<4 OR SHX(I)<-8 OR SHX(I)>160 THEN
        SHA(I)=0
        SPRITE OFF I
      ELSE
        SPRITE I,SHX(I),SHY(I),
        IF CO AND QL>0 THEN
          IF SPRITE HIT(I,21 TO 32) THEN
            E=HIT-21
            IF QA(E) THEN
              SHA(I)=0
              SPRITE OFF I
              CALL HURTE(E,SHD(I))
            END IF
          END IF
        END IF
        IF CO AND SHA(I) AND BV THEN
          IF SPRITE HIT(I,3 TO 6) THEN
            SHA(I)=0
            SPRITE OFF I
            CALL BOSSHIT(SHD(I))
          END IF
        END IF
      END IF
    END IF
  NEXT I
END SUB

'PLAYER SHOT IN THE NEXT SLOT 7-20
SUB SHOT(X0,Y0,VX,VY,D,C)
  I=NSS
  ADD NSS,1,7 TO 20
  SHA(I)=-1
  SHX(I)=X0
  SHY(I)=Y0
  SHVX(I)=VX
  SHVY(I)=VY
  SHD(I)=D
  SPRITE I,X0,Y0,C
END SUB

SUB SETSHIELD(SZ)
  SHSZ=SZ
  SPRITE 2 SIZE SHS(SZ)
  'ABSORB DISTANCE PER BULLET TYPE
  FOR K=0 TO 4
    R=SHRT(SZ)+HS(K)*0.5
    SR2(K)=R*R
  NEXT K
END SUB

'BK: 0 BULLET, 2 SPARK, 3 EXPLOSION
SUB MOVEB
  CX=PX+8
  CY=PY+8
  FOR I=33 TO 63
    IF BA(I) THEN
      IF BK(I)=3 THEN
        INC BAG(I)
        IF BAG(I)>=15 THEN
          BA(I)=0
          BK(I)=0
          SPRITE OFF I
        ELSE
          ADD BX(I),BDX(I)
          ADD BY(I),BDY(I)
          SPRITE I,BX(I),BY(I),EXC(BAG(I)\5)
        END IF
      ELSE
        ADD BX(I),BDX(I)
        ADD BY(I),BDY(I)
        IF BY(I)>130 OR BY(I)<-24 OR BX(I)<-24 OR BX(I)>162 THEN
          BA(I)=0
          SPRITE OFF I
        ELSE IF SHON AND BK(I)=0 THEN
          TY=BT(I)
          DX=BX(I)+HS(TY)-CX
          DY=BY(I)+HS(TY)-CY
          IF DX*DX+DY*DY<SR2(TY) THEN
            BA(I)=0
            SPRITE OFF I
            CALL ABSORB(TN(TY))
          ELSE
            SPRITE I,BX(I),BY(I),
          END IF
        ELSE
          SPRITE I,BX(I),BY(I),
        END IF
      END IF
    END IF
  NEXT I
END SUB

'THE SHIELD SOAKED UP N BULLETS
SUB ABSORB(N)
  SHG=SHG-4*N
  IF SHG<=0 THEN
    SHG=0
    SHBRK=-1
    SHON=0
    SPRITE OFF 2
    PLAY 3,20,30 SOUND 9
    CALL FIRE(PX+8,PY+8,0,0,6)
  ELSE
    PLAY 2,84,1 SOUND 8
  END IF
END SUB

'PHASE CHANGES TURN BULLETS INTO
'HARMLESS SPARKS
SUB CANCEL
  FOR I=33 TO 63
    IF BA(I) THEN
      IF BK(I)=0 THEN
        BK(I)=2
        ADD BX(I),HS(BT(I))-4
        ADD BY(I),HS(BT(I))-4
        BT(I)=5
        BDX(I)=BDX(I)*0.4
        BDY(I)=BDY(I)*0.4-0.5
        SPRITE I,BX(I),BY(I),14
        SPRITE I PAL 4 SIZE 0
      END IF
    END IF
  NEXT I
END SUB

SUB FIRE(X0,Y0,AN,SPD,TY)
  I=NB
  ADD NB,1,33 TO 63
  IF BA(I) THEN EXIT SUB
  BA(I)=-1
  BK(I)=0
  IF TY=5 THEN BK(I)=2
  IF TY=6 THEN
    BK(I)=3
    BAG(I)=0
  END IF
  BT(I)=TY
  BX(I)=X0-HS(TY)
  BY(I)=Y0-HS(TY)
  BDX(I)=COS(AN)*SPD
  BDY(I)=SIN(AN)*SPD
  SPRITE I,BX(I),BY(I),TC(TY)
  SPRITE I PAL TP(TY) SIZE TZ(TY)
END SUB

SUB AIM(X0,Y0)
  DX=PX+8-X0
  DY=PY+8-Y0
  IF DX=0 THEN DX=0.001
  AA=ATAN(DY/DX)
  IF DX<0 THEN AA=AA+PI
END SUB

'NEW ENEMY IN THE FIRST FREE SLOT
SUB SPAWN(TY,X0,IX)
  FOR E=0 TO 11
    IF QA(E)=0 THEN
      QA(E)=-1
      QT(E)=TY
      QG(E)=0
      S=21+E
      BK(S)=4
      INC TOT
      IF TY=0 THEN
        'DART: A PINK FIGHTER, DIVING
        QX(E)=X0
        QY(E)=-16
        QU(E)=X0
        QH(E)=2
        SPRITE S PAL 2 SIZE 1 FLIP 0,1
        SPRITE S,X0,-16,2
      ELSE IF TY=1 THEN
        'SIDE FIGHTER: FAST, FROM A SIDE
        QH(E)=2
        IF X0>0 THEN
          QX(E)=-16
          QY(E)=X0
          QU(E)=2.2
          SPRITE S PAL 3 SIZE 1 FLIP 0,0
        ELSE
          QX(E)=160
          QY(E)=-X0
          QU(E)=-2.2
          SPRITE S PAL 3 SIZE 1 FLIP 1,0
        END IF
        SPRITE S,QX(E),QY(E),36
      ELSE IF TY=2 THEN
        'ORB: CROSSES, FIRING RINGS
        QX(E)=X0
        QV(E)=24+IX*14
        QY(E)=QV(E)
        IF X0<80 THEN QU(E)=0.8 ELSE QU(E)=-0.8
        QH(E)=6
        SPRITE S PAL 7 SIZE 1 FLIP 0,0
        SPRITE S,X0,QY(E),38
      ELSE IF TY=3 THEN
        'GUNSHIP: HOVERS, THEN LEAVES
        QX(E)=X0
        QY(E)=-16
        QH(E)=14
        SPRITE S PAL 3 SIZE 1 FLIP 0,0
        SPRITE S,X0,-16,40
      ELSE
        'HEAVY CARRIER: SLOW AND TOUGH
        QX(E)=X0
        QY(E)=-24
        QH(E)=45
        SPRITE S PAL 3 SIZE 2 FLIP 0,0
        SPRITE S,X0,-24,67
      END IF
      EXIT SUB
    END IF
  NEXT E
END SUB

SUB MOVEE
  QL=0
  FOR E=0 TO 11
    IF QA(E) THEN
      INC QG(E)
      G=QG(E)
      TY=QT(E)
      X0=QX(E)+8
      Y0=QY(E)+8
      IF TY=0 THEN
        ADD QY(E),1.3
        QX(E)=QU(E)+SIN(G*0.05)*28
        IF G=40 OR (G=75 AND AREA>1) THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0+4,AA,1.1,0)
        END IF
      ELSE IF TY=1 THEN
        ADD QX(E),QU(E)
        ADD QY(E),G*0.012
        IF G=30 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0,AA,1.2,0)
        END IF
      ELSE IF TY=2 THEN
        ADD QX(E),QU(E)
        QY(E)=QV(E)+SIN(G*0.06)*8
        IF G MOD 80=40 THEN
          N4=4+(AREA>2)*-2
          FOR K=1 TO N4
            CALL FIRE(X0,Y0,K*2*PI/N4+G,0.8,1)
          NEXT K
        END IF
      ELSE IF TY=3 THEN
        IF G<70 THEN
          ADD QY(E),0.7
        ELSE IF G>260 THEN
          ADD QY(E),-0.8
        END IF
        IF G=100 OR G=160 OR G=220 THEN
          CALL AIM(X0,Y0)
          FOR K=-1 TO 1
            CALL FIRE(X0,Y0+6,AA+K*0.25,1.2,0)
          NEXT K
        END IF
      ELSE
        ADD QY(E),0.35
        X0=QX(E)+12
        Y0=QY(E)+12
        IF G MOD 90=45 THEN
          FOR K=0 TO 7
            CALL FIRE(X0,Y0,K*PI/4+G,0.7,0)
          NEXT K
        END IF
        IF G MOD 60=0 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0-6,Y0+8,AA,1,1)
          CALL FIRE(X0+6,Y0+8,AA,1,1)
        END IF
      END IF
      'LEFT THE SCREEN ALIVE: ESCAPED
      IF QY(E)>132 OR QX(E)<-26 OR QX(E)>170 OR (TY=3 AND G>260 AND QY(E)<-18) THEN
        QA(E)=0
        SPRITE OFF 21+E
        INC ESC
        MUL=MAX(1,MUL-1)
        PLAY 3,30,6 SOUND 6
      ELSE
        SPRITE 21+E,QX(E),QY(E),
        INC QL
      END IF
    END IF
  NEXT E
END SUB

SUB HURTE(E,D)
  ADD QH(E),-D
  IF QH(E)<=0 THEN
    QA(E)=0
    SPRITE OFF 21+E
    TY=QT(E)
    IF TY=4 THEN
      CALL FIRE(QX(E)+12,QY(E)+12,0,0,6)
    ELSE
      CALL FIRE(QX(E)+8,QY(E)+8,0,0,6)
    END IF
    'FAST KILLS RAISE THE MULTIPLIER
    'MORE
    V=0.1
    IF QG(E)<QK(TY) THEN V=0.25
    CALL KILLSCORE(QB(TY),V)
    INC KIL
    PLAY 3,24+RND(6),14 SOUND 5
  ELSE
    PLAY 3,50,1 SOUND 6
  END IF
END SUB

SUB KILLSCORE(B,V)
  ADD SC,INT(B*MUL)
  OLD=INT(MUL)
  MUL=MIN(9.9,MUL+V)
  IF INT(MUL)>OLD THEN PLAY 3,68+INT(MUL)*2,8 SOUND 4
  IF MUL>MMAX THEN MMAX=MUL
  LKT=0
  'HIDDEN 1UP COUNTER
  INC ONEUP
  IF ONEUP>=150 THEN
    ONEUP=0
    INC LIVES
    CALL HUD
    PLAY 2,90,30 SOUND 4
  END IF
END SUB

'BOSS: THE LEFT HALF IS SPRITES 3
'AND 5, THE RIGHT HALF THE SAME ART
'FLIPPED (4 AND 6)
SUB BOSSMOVE
  IF BYO<14 THEN
    ADD BYO,0.5
  ELSE IF PHT=0 THEN
    BV=-1
  END IF
  BXO=56+SIN(T*0.019*(1+PH*0.3))*46
  Y=BYO
  IF PH=2 THEN Y=BYO-6+SIN(T*0.05)*3
  SPRITE 3,BXO,Y,70
  SPRITE 4,BXO+24,Y,70
  SPRITE 5,BXO,Y+24,73
  SPRITE 6,BXO+24,Y+24,73
  GX=BXO+24
  GY=Y+24
END SUB

SUB BOSSFIRE
  IF PH=1 THEN
    'SHOULDER CANNONS AND A WIDE FAN
    IF T MOD 40=0 THEN
      FOR S=0 TO 1
        X0=BXO+7+S*34
        CALL AIM(X0,GY+10)
        FOR K=-1 TO 1
          CALL FIRE(X0,GY+10,AA+K*0.22,1.3,0)
        NEXT K
      NEXT S
    END IF
    IF T MOD 60=30 THEN
      FOR K=-5 TO 5
        CALL FIRE(GX,GY,PI/2+K*0.17,0.85,1)
      NEXT K
    END IF
  ELSE IF PH=2 THEN
    'ESCORT DARTS, SLOW RINGS
    IF T MOD 100=0 THEN
      CALL SPAWN(0,BXO-4,0)
      CALL SPAWN(0,BXO+36,0)
    END IF
    IF T MOD 45=20 THEN
      FOR K=0 TO 9
        CALL FIRE(GX,GY,K*PI/5+RO,0.8,1)
      NEXT K
      ADD RO,0.2
    END IF
  ELSE
    'STORM BLADE: SPIRAL AND FAST FANS
    IF T MOD 5=0 THEN
      CALL FIRE(GX,GY,A1,1.05,3)
      ADD A1,0.41
    END IF
    IF T MOD 35=0 THEN
      CALL AIM(GX,GY)
      FOR K=-2 TO 2
        CALL FIRE(GX,GY,AA+K*0.2,1.6,0)
      NEXT K
    END IF
  END IF
END SUB

SUB BOSSHIT(D)
  ADD HP,-D
  ADD SC,INT(5*D*MUL)
  FL=2
  IF T MOD 4=0 THEN PLAY 3,40,1 SOUND 6
END SUB

SUB PHASEUP(P)
  PH=P
  BV=0
  PHT=70
  ADD SC,5000
  CALL CANCEL
  FL=2
  PLAY 3,20,40 SOUND 5
END SUB

SUB PLAYERDIE
  DEC LIVES
  MUL=1
  'DEATHS ALSO FILL THE 1UP COUNTER
  ADD ONEUP,40
  INV=150
  DEAD=45
  SHON=0
  SPRITE OFF 2
  PLAY 3,8,40 SOUND 5
  CALL CLEARB
  CALL FIRE(PX+8,PY+8,0,0,6)
  FOR K=0 TO 7
    CALL FIRE(PX+8,PY+8,K*PI/4,1.1,5)
  NEXT K
  SPRITE OFF 0 TO 1
  CALL HUD
END SUB

'PAUSE MENU IN THE HUD ROW
SUB PAUSEMENU
  STOP
  SEL=0
  QUIT=0
  OSEL=-1
  DO
    IF UP TAP(0) OR LEFT TAP(0) THEN SEL=0
    IF DOWN TAP(0) OR RIGHT TAP(0) THEN SEL=1
    IF SEL<>OSEL THEN
      OSEL=SEL
      BG 1
      BG FILL 0,0 TO 19,0 CHAR 0
      PAL 4
      IF SEL=0 THEN
        TEXT 0,0,"PAUSED >RESUME  QUIT"
      ELSE
        TEXT 0,0,"PAUSED  RESUME >QUIT"
      END IF
    END IF
    IF PAUSE THEN EXIT
    IF BUTTON TAP(0,0) THEN
      IF SEL=1 THEN QUIT=-1
      EXIT
    END IF
    WAIT VBL
  LOOP
  IF QUIT=0 THEN
    IF AREA<4 THEN MUSIC 0 ELSE MUSIC 4
  END IF
  CALL HUD
END SUB

'GAME OVER: 10 SECONDS TO CONTINUE.
'A CARRIES ON (SCORE RESETS), B QUITS
SUB CONTPROMPT
  STOP
  PLAY 3,40,30 SOUND 5
  FOR CD=9 TO 0 STEP -1
    BG 1
    BG FILL 0,0 TO 19,0 CHAR 0
    PAL 4
    TEXT 0,0,"CONTINUE  PRESS A"
    NUMBER 18,0,CD,1
    FOR F=1 TO 60
      IF BUTTON TAP(0,0) THEN
        LIVES=3
        SC=0
        MUL=1
        CALL HUD
        PLAY 2,96,10 SOUND 4
        IF AREA<4 THEN MUSIC 0 ELSE MUSIC 4
        EXIT SUB
      END IF
      IF BUTTON TAP(0,1) THEN EXIT SUB
      CALL STEPSTARS
      WAIT VBL
    NEXT F
  NEXT CD
END SUB

